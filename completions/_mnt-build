#compdef mnt-build

_mnt_build() {
  local context state line
  typeset -A opt_args

  local -a global_opts
  global_opts=(
    '--help[show help]'
    '--version[show tool version]'
  )

  local -a sysimages
  sysimages=(
    pocket-reform-system-a311d
    reform-next-system-rk3588
    pocket-reform-system-rk3588
    pocket-reform-system-imx8mp
    pocket-reform-system-rk3588s
  )

  if (( CURRENT == 2 )); then
    _arguments -s \
      $global_opts \
      '1:subcommand:(build clean dev-kernel uboot)'
    return
  fi

  local subcmd="$words[2]"

  case "$subcmd" in
    build)
      _arguments -s \
        '--help[show build help]' \
        '--kversion=[kernel version]:kversion:' \
        '--build-dir=[build directory]:directory:_files -/' \
        '(-j --jobs)'{-j,--jobs}'[parallel jobs]:jobs:' \
        '--localversion-rev=[kernel localversion revision]:rev:' \
        '--dry-run[check/apply patches only]' \
        '--olddefconfig[run olddefconfig and persist config]' \
        '--defconfig[alias for --olddefconfig]' \
        '--post-clean[run mrproper after olddefconfig dry-run]' \
        '--skip-git-ops[skip git reset/checkout/tag ops]' \
        '--arch=[kernel ARCH]:arch:' \
        '--cross-compile=[cross compile prefix]:prefix:' \
        '--with-headers[generate extmod headers tree]' \
        '(--dtbs-only --modules-only)--kernel-only[build kernel image only]' \
        '(--kernel-only --modules-only)--dtbs-only[build DTBs only (ARM64)]' \
        '(--kernel-only --dtbs-only)--modules-only[build and install in-tree modules only]' \
        '--kernel=[kernel checkout dir under build_dir, e.g. mnt-linux]:kernel:' \
        '--verruckt[commit each successfully applied patch]'
      ;;
    clean)
      _arguments -s \
        '--help[show clean help]' \
        '--build-dir=[build directory]:directory:_files -/' \
        '--kernel=[kernel checkout dir under build_dir; use mnt-linux to repair its version tag]:kernel:' \
        '--kversion=[kernel version whose tag to repair; only relevant with --kernel mnt-linux]:kversion:'
      ;;
    dev-kernel)
      _arguments -s \
        '--help[show dev-kernel help]' \
        '--build-dir=[build directory]:directory:_files -/' \
        '--kernel=[kernel checkout dir under build_dir (default: mnt-linux)]:kernel:' \
        '--kversion=[kernel version: series for the status report, target for rebase]:kversion:' \
        '--from=[with rebase: branch to rebase from (default: newest mnt-v branch of the series)]:branch:' \
        '--offline[do not contact the remotes]' \
        '--log[also write output to a log file in the build directory]' \
        '2::action:(add-remotes fetch rebase)'
      ;;
    uboot)
      _arguments -s \
        '--help[show uboot help]' \
        '--list[list configuration]:object:(sysimage)' \
        '--sysimage[target sysimage]:sysimage:('"${sysimages[*]}"')' \
        '--dry-run[clone/fetch repo, checkout tag, apply patches]' \
        '--diff[build if needed, then compare against MNT prebuilt]' \
        '--menuconfig[run make menuconfig in the U-Boot checkout]' \
        '--clean[remove the U-Boot checkout entirely]' \
        '--reset[reset inner u-boot/ sub-repo to the SHA expected by build.sh]'
      ;;
    *)
      _message 'subcommand' 'build clean dev-kernel uboot'
      ;;
  esac
}

_mnt_build "$@"
