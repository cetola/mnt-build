From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Codex <codex@openai.com>
Date: Fri, 10 Apr 2026 22:50:00 +0000
Subject: [PATCH] qcacld2: include linux/hex.h for hex2bin and mac_pton

Kernel 7.0 no longer exposes the prototypes for hex2bin() and mac_pton()
indirectly to these qcacld2 translation units.

Include linux/hex.h explicitly so the vendor driver continues to build.
---
 CORE/HDD/src/wlan_hdd_cfg.c  | 1 +
 CORE/HDD/src/wlan_hdd_main.c | 1 +
 2 files changed, 2 insertions(+)

diff --git a/CORE/HDD/src/wlan_hdd_cfg.c b/CORE/HDD/src/wlan_hdd_cfg.c
index 16304cb..771b332 100644
--- a/CORE/HDD/src/wlan_hdd_cfg.c
+++ b/CORE/HDD/src/wlan_hdd_cfg.c
@@ -50,6 +50,7 @@
 
 #include <linux/firmware.h>
 #include <linux/string.h>
+#include <linux/hex.h>
 #include <wlan_hdd_includes.h>
 #include <wlan_hdd_main.h>
 #include <wlan_hdd_assoc.h>
diff --git a/CORE/HDD/src/wlan_hdd_main.c b/CORE/HDD/src/wlan_hdd_main.c
index 9caf7a7..b33b7cf 100644
--- a/CORE/HDD/src/wlan_hdd_main.c
+++ b/CORE/HDD/src/wlan_hdd_main.c
@@ -66,6 +66,7 @@
 #endif
 #include <linux/etherdevice.h>
 #include <linux/firmware.h>
+#include <linux/hex.h>
 #include <wcnss_api.h>
 #include <wlan_hdd_tx_rx.h>
 #include <wniApi.h>
-- 
2.43.0
