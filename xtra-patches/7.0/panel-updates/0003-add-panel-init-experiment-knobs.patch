From 1f77104447272b81a1a0edd6f0b9cdd0a4492c41 Mon Sep 17 00:00:00 2001
From: Stephano Cetola <stephanoc@gmail.com>
Date: Tue, 17 Mar 2026 11:12:35 -0700
Subject: [PATCH] add panel init experiment knobs

---
 .../gpu/drm/panel/panel-mnt-pocket-reform.c   | 53 ++++++++++++++++++-
 1 file changed, 51 insertions(+), 2 deletions(-)

diff --git a/drivers/gpu/drm/panel/panel-mnt-pocket-reform.c b/drivers/gpu/drm/panel/panel-mnt-pocket-reform.c
index 8aed01dafe6b..83783c8a7093 100644
--- a/drivers/gpu/drm/panel/panel-mnt-pocket-reform.c
+++ b/drivers/gpu/drm/panel/panel-mnt-pocket-reform.c
@@ -36,6 +36,27 @@ static const char * const regulator_names[] = {
 	"iovcc"
 };
 
+
+static unsigned int pre_init_settle_delay_ms;
+module_param(pre_init_settle_delay_ms, uint, 0644);
+MODULE_PARM_DESC(pre_init_settle_delay_ms,
+	"Extra one-time delay in ms before the first panel init attempt");
+
+static bool force_v2_tables_first_init;
+module_param(force_v2_tables_first_init, bool, 0644);
+MODULE_PARM_DESC(force_v2_tables_first_init,
+	"Force the v2 vendor init tables to be sent on the first v2 init");
+
+static unsigned int post_gpio_settle_delay_ms;
+module_param(post_gpio_settle_delay_ms, uint, 0644);
+MODULE_PARM_DESC(post_gpio_settle_delay_ms,
+	"Extra delay in ms after GPIO sequencing in prepare before later init/display-on work");
+
+static int force_panel_version;
+module_param(force_panel_version, int, 0644);
+MODULE_PARM_DESC(force_panel_version,
+	"Force panel version selection: 0=auto, 1=v1, 2=v2");
+
 struct jdi_panel {
 	struct drm_panel base;
 	struct mipi_dsi_device *dsi;
@@ -131,6 +152,10 @@ static void jdi_dump_core_state(struct jdi_panel *jdi, const char *where)
 		  jdi_bool(jdi->prepared), jdi_bool(jdi->enabled), jdi->panel_version,
 		  jdi->display_v1_init_count, jdi->display_v2_init_count,
 		  jdi->dsi->lanes, jdi->dsi->format, flags);
+	jdi_trace(jdi, where,
+		  "knobs: pre_init_settle_delay_ms=%u force_v2_tables_first_init=%s post_gpio_settle_delay_ms=%u force_panel_version=%d",
+		  pre_init_settle_delay_ms, jdi_bool(force_v2_tables_first_init),
+		  post_gpio_settle_delay_ms, force_panel_version);
 	jdi_dump_supplies(jdi, where);
 	jdi_dump_gpios(jdi, where);
 }
@@ -420,7 +445,7 @@ static int pocket_display_v2_init(struct jdi_panel *jdi)
 	// for unknown reasons, if we send all the data tables
 	// on the first init, it takes very long (~14 seconds),
 	// but it's quick the second time around.
-	if (jdi->display_v2_init_count > 0) {
+	if (force_v2_tables_first_init || jdi->display_v2_init_count > 0) {
 		ret = dsi_write_raw(jdi, (u8[]) {0xE0,0xAB,0xBA}, 3, "v2-0xE0");
 		if (ret < 0)
 			return ret;
@@ -1234,11 +1259,27 @@ static int jdi_panel_init(struct jdi_panel *jdi)
 		dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
 	}
 
+	if (!jdi->display_v1_init_count && !jdi->display_v2_init_count &&
+	    pre_init_settle_delay_ms) {
+		jdi_trace(jdi, __func__,
+			  "applying extra first-init settle delay of %u ms",
+			  pre_init_settle_delay_ms);
+		msleep(pre_init_settle_delay_ms);
+		jdi_trace(jdi, __func__, "extra first-init settle delay complete");
+	}
+
 	jdi_trace(jdi, __func__, "sleeping 20ms before panel identification");
 	msleep(20);
 	jdi_trace(jdi, __func__, "20ms identify delay complete");
 
-	if (!jdi->panel_version) {
+	if (force_panel_version == 1 || force_panel_version == 2) {
+		if (jdi->panel_version != force_panel_version)
+			jdi_trace(jdi, __func__,
+				  "forcing panel version to %d (was %d)",
+				  force_panel_version, jdi->panel_version);
+		jdi->panel_version = force_panel_version;
+		__global_mnt_pocket_reform_panel_version = force_panel_version;
+	} else if (!jdi->panel_version) {
 		ret = jdi_dcs_read_u8(jdi, 12, &readval);
 		if (ret < 0)
 			dev_warn(dev, "[mnt pocket reform display] failed to read register 12a, defaulting to v2\n");
@@ -1371,6 +1412,14 @@ static int jdi_panel_prepare(struct drm_panel *panel)
 	jdi_dump_gpios(jdi, __func__);
 	usleep_range(10, 20);
 
+	if (post_gpio_settle_delay_ms) {
+		jdi_trace(jdi, __func__,
+			  "sleeping %u ms after gpio sequencing before init/display-on",
+			  post_gpio_settle_delay_ms);
+		msleep(post_gpio_settle_delay_ms);
+		jdi_trace(jdi, __func__, "post-gpio settle delay complete");
+	}
+
 	if (!of_property_present(dev->of_node, "init-in-enable")) {
 		// on a311d the panels only work
 		// if init is done in here, not in enable
-- 
2.47.3

