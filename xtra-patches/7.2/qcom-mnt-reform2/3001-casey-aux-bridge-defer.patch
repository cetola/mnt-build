From 08d0bad1f3ec3137cab66d5b9b349bed612bac3e Mon Sep 17 00:00:00 2001
From: "Lucie L. Hartmann" <lucie@mntre.com>
Date: Fri, 14 Aug 2026 07:01:25 +0200
Subject: [PATCH 1/2] 3001-casey-aux-bridge-defer.patch

---
 drivers/gpu/drm/bridge/aux-bridge.c | 12 +++++++-----
 1 file changed, 7 insertions(+), 5 deletions(-)

diff --git a/drivers/gpu/drm/bridge/aux-bridge.c b/drivers/gpu/drm/bridge/aux-bridge.c
index 1ed21a8713bf..08f027716376 100644
--- a/drivers/gpu/drm/bridge/aux-bridge.c
+++ b/drivers/gpu/drm/bridge/aux-bridge.c
@@ -72,6 +72,8 @@ int drm_aux_bridge_register(struct device *parent)
 		return ret;
 	}
 
+	dev_info(&adev->dev, "CAS: Registering aux bridge for %s\n", dev_name(parent));
+
 	ret = auxiliary_device_add(adev);
 	if (ret) {
 		auxiliary_device_uninit(adev);
@@ -99,6 +101,11 @@ static int drm_aux_bridge_attach(struct drm_bridge *bridge,
 
 	data = container_of(bridge, struct drm_aux_bridge_data, bridge);
 
+	data->next_bridge = devm_drm_of_get_bridge(data->dev, data->dev->of_node, 0, 0);
+	if (IS_ERR(data->next_bridge))
+		return dev_err_probe(data->dev, PTR_ERR(data->next_bridge),
+				     "failed to acquire drm_bridge\n");
+
 	return drm_bridge_attach(encoder, data->next_bridge, bridge,
 				 DRM_BRIDGE_ATTACH_NO_CONNECTOR);
 }
@@ -118,11 +125,6 @@ static int drm_aux_bridge_probe(struct auxiliary_device *auxdev,
 		return PTR_ERR(data);
 
 	data->dev = &auxdev->dev;
-	data->next_bridge = devm_drm_of_get_bridge(&auxdev->dev, auxdev->dev.of_node, 0, 0);
-	if (IS_ERR(data->next_bridge))
-		return dev_err_probe(&auxdev->dev, PTR_ERR(data->next_bridge),
-				     "failed to acquire drm_bridge\n");
-
 	data->bridge.of_node = data->dev->of_node;
 
 	/* passthrough data, allow everything */
-- 
