+struct jdi_panel {
+	struct drm_panel base;
+	struct mipi_dsi_device *dsi;
+
+	struct gpio_desc *enable_gpio;
+	struct gpio_desc *reset_gpio;
+	struct gpio_desc *dispv2_gpio;
+	struct backlight_device *backlight;
+
+	bool prepared;
+	bool enabled;
+	int panel_version;
+};
+
+static ssize_t panel_version_attr_show(struct device *dev, struct device_attribute *attr, char *buf) {
+	struct jdi_panel *jdi = (struct jdi_panel *)dev_get_drvdata(dev);
+	return sprintf(buf, "%d\n", jdi->panel_version);
+}
+static ssize_t panel_dcs_read_attr_show(struct device *dev, struct device_attribute *attr, char *buf) {
+	return sprintf(buf, "%d\n", 0);
+}
+static ssize_t panel_dcs_read_attr_store(struct device *dev, struct device_attribute *attr, const char *buf, size_t count) {
+	struct jdi_panel *jdi = (struct jdi_panel *)dev_get_drvdata(dev);
+	long command;
+	int ret = (int)kstrtol(buf, 10, &command);
+	u8 readval = 0;
+	if (ret == 0 && command > 0) {
+		jdi->dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
+		mipi_dsi_dcs_read(jdi->dsi, (int)command, &readval, sizeof(readval));
+		dev_err(dev, "[mnt pocket reform display] DCS command %d read result: 0x%x\n", (int)command, (int)readval);
+	}
+	return count;
+}
+static int jdi_panel_enable(struct drm_panel *panel);
+static ssize_t panel_enable_attr_show(struct device *dev, struct device_attribute *attr, char *buf) {
+	struct jdi_panel *jdi = (struct jdi_panel *)dev_get_drvdata(dev);
+	jdi_panel_enable(&jdi->base);
+	return sprintf(buf, "%d\n", 0);
+}
+static int jdi_panel_prepare(struct drm_panel *panel);
+static ssize_t panel_prepare_attr_show(struct device *dev, struct device_attribute *attr, char *buf) {
+	struct jdi_panel *jdi = (struct jdi_panel *)dev_get_drvdata(dev);
+	jdi_panel_prepare(&jdi->base);
+	return sprintf(buf, "%d\n", 0);
+}
+static DEVICE_ATTR(mnt_pocket_reform_panel_version, 0444, panel_version_attr_show, NULL);
+static DEVICE_ATTR(mnt_pocket_reform_panel_dcs_read, 0644, panel_dcs_read_attr_show, panel_dcs_read_attr_store);
+static DEVICE_ATTR(mnt_pocket_reform_panel_prepare, 0444, panel_prepare_attr_show, NULL);
+static DEVICE_ATTR(mnt_pocket_reform_panel_enable, 0444, panel_enable_attr_show, NULL);
+static struct attribute *mnt_pocket_reform_panel_attrs[] = {
+	&dev_attr_mnt_pocket_reform_panel_version.attr,
+	&dev_attr_mnt_pocket_reform_panel_dcs_read.attr,
+	&dev_attr_mnt_pocket_reform_panel_prepare.attr,
+	&dev_attr_mnt_pocket_reform_panel_enable.attr,
+	NULL
+};
+static const struct attribute_group mnt_pocket_reform_panel_attr_group = {
+	.attrs = mnt_pocket_reform_panel_attrs,
+};
+
+static inline struct jdi_panel *to_jdi_panel(struct drm_panel *panel)
+{
+	return container_of(panel, struct jdi_panel, base);
+}
+
+static int dsi_dcs_bl_get_brightness(struct backlight_device *bl)
+{
+	u16 brightness = bl->props.brightness;
+	return (int)brightness;
+}
+
+static int dsi_dcs_bl_update_status(struct backlight_device *bl)
+{
+	struct jdi_panel *jdi = bl_get_data(bl);
+	struct mipi_dsi_device *dsi = jdi->dsi;
+
+	if (!jdi->enabled || !jdi->prepared || !jdi->backlight) {
+		return -ENODEV;
+	}
+
+	dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
+
+	mipi_dsi_dcs_set_display_brightness(dsi, bl->props.brightness);
+
+	dsi->mode_flags |= MIPI_DSI_MODE_LPM;
+
+	return 0;
+}
+
+static const struct backlight_ops dsi_bl_ops = {
+	.update_status = dsi_dcs_bl_update_status,
+	.get_brightness = dsi_dcs_bl_get_brightness,
+};
+
+static struct backlight_device *
+drm_panel_create_dsi_backlight(struct jdi_panel *jdi)
+{
+	struct device *dev = &jdi->dsi->dev;
+	struct backlight_properties props;
+
+	memset(&props, 0, sizeof(props));
+	props.type = BACKLIGHT_RAW;
+	props.brightness = 255;
+	props.max_brightness = 255;
+
+	return devm_backlight_device_register(dev, dev_name(dev), dev, jdi,
+					      &dsi_bl_ops, &props);
+}
+
+static ssize_t dsi_write_raw(struct mipi_dsi_device *dsi,
+			     const void *data, size_t len)
+{
+	const struct mipi_dsi_msg msg = {
+		.channel = dsi->channel,
+		.tx_buf = data,
+		.tx_len = len,
+		.type = MIPI_DSI_DCS_LONG_WRITE,
+		.flags = MIPI_DSI_MSG_USE_LPM
+	};
+
+	return dsi->host->ops->transfer(dsi->host, &msg);
+}
+
+static int mnt_panel_power_on(struct jdi_panel *jdi)
+{
+	struct device *dev = &jdi->dsi->dev;
+	dev_info(dev, "[mnt_panel_power_on] panel version: %d\n", jdi->panel_version);
+
+	// assert reset if we know it's panel v2
+	if (jdi->panel_version == 2) {
+		// TODO: panel v1 doesn't like the HW reset?
+		if (!IS_ERR(jdi->reset_gpio)) {
+			for (int i=0; i<10; i++) {
+				int ret = gpiod_set_value_cansleep(jdi->reset_gpio, 1);
+				if (!ret) break;
+				msleep(100);
+			}
+		}
+	}
+	msleep(50);
+	if (!IS_ERR(jdi->enable_gpio)) gpiod_set_value_cansleep(jdi->enable_gpio, 1);
+	msleep(50);
+
+	// make sure the panel is out of reset, regardless of version
+	if (!IS_ERR(jdi->reset_gpio)) {
+		for (int i=0; i<10; i++) {
+			int ret = gpiod_set_value_cansleep(jdi->reset_gpio, 0);
+			if (!ret) break;
+			msleep(100);
+		}
+	}
+	msleep(100);
+
+	return 0;
+}
+
+static void mnt_panel_power_off(struct jdi_panel *jdi)
+{
+	struct device *dev = &jdi->dsi->dev;
+	dev_info(dev, "[mnt_panel_power_off] panel version: %d\n", jdi->panel_version);
+
+	// the key to preventing the "half screen" problem with display v2
+	// is turning the panel off in the right way: the reset has to
+	// come first.
+	if (jdi->panel_version == 2) {
+		if (!IS_ERR(jdi->reset_gpio)) {
+			for (int i=0; i<10; i++) {
+				int ret = gpiod_set_value_cansleep(jdi->reset_gpio, 1);
+				if (!ret) break;
+				msleep(100);
+			}
+		}
+	}
+	msleep(50);
+	if (!IS_ERR(jdi->enable_gpio)) gpiod_set_value_cansleep(jdi->enable_gpio, 0);
+	msleep(50);
+	// finally, we deassert the reset in case barebox/another OS doesn't
+	// know how to do that after a warm reboot.
+	if (!IS_ERR(jdi->reset_gpio)) {
+		for (int i=0; i<10; i++) {
+			int ret = gpiod_set_value_cansleep(jdi->reset_gpio, 0);
+			if (!ret) break;
+			msleep(100);
+		}
+	}
+}
+
+static int mnt_panel_detect_version(struct jdi_panel *jdi)
+{
+	struct mipi_dsi_device *dsi = jdi->dsi;
+	struct device *dev = &jdi->dsi->dev;
+	u8 readval = 0;
+
+	if (jdi->panel_version) {
+		return 0;
+	}
+
+	dsi->mode_flags |= MIPI_DSI_MODE_LPM;
+	int ret = mipi_dsi_dcs_read(dsi, 12, &readval, sizeof(readval));
+	dev_info(dev, "[mnt_panel_detect_version] read register 12: 0x%x\n", (int)readval);
+	if (ret < 0) {
+		dev_err(dev, "[mnt_panel_detect_version] panel not ready (%d).\n", ret);
+		// TODO: not sure how to handle this, hard reset doesn't
+		// fix it
+	}
+
+	if (readval == 0x77 || readval == 0x70) {
+		jdi->panel_version = 1;
+	} else {
+		jdi->panel_version = 2;
+	}
+	dev_info(dev, "[mnt_panel_detect_version] detected panel_version: %d\n",
+		 jdi->panel_version);
+	if (jdi->panel_version == 2) {
+		// if we freshly detect display panel v2, we need to repeat it's power
+		// on sequence, as we couldn't do the proper sequence
+		// without knowing the correct panel version.
+		mnt_panel_power_on(jdi);
+	}
+	return 0;
+}
+
