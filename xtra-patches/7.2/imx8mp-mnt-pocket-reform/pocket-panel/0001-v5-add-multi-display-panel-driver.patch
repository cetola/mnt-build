+static int jdi_panel_add(struct jdi_panel *jdi)
+{
+	struct device *dev = &jdi->dsi->dev;
+	int ret;
+
+	jdi->enable_gpio = devm_gpiod_get(dev, "enable", GPIOD_OUT_LOW);
+	if (IS_ERR(jdi->enable_gpio))
+		dev_warn_probe(dev, PTR_ERR(jdi->enable_gpio),
+			       "cannot get (optional) enable-gpio %d\n", ret);
+
+	for (int i = 0; i < 10; i++) {
+		jdi->reset_gpio = devm_gpiod_get(dev, "reset", GPIOD_OUT_HIGH);
+		if (!IS_ERR(jdi->reset_gpio)) break;
+		msleep(100);
+	}
+	if (IS_ERR(jdi->reset_gpio))
+		dev_err_probe(dev, PTR_ERR(jdi->reset_gpio),
+			      "cannot get reset-gpios %d\n", ret);
+
+	for (int i = 0; i < 10; i++) {
+		jdi->dispv2_gpio = devm_gpiod_get(dev, "dispv2", GPIOD_OUT_LOW);
+		if (!IS_ERR(jdi->dispv2_gpio)) break;
+		msleep(100);
+	}
+	if (IS_ERR(jdi->dispv2_gpio))
+		dev_warn_probe(dev, PTR_ERR(jdi->dispv2_gpio),
+			       "cannot get (optional) dispv2-gpio %d\n", ret);
+
+	drm_panel_add(&jdi->base);
+
+	return 0;
+}
+
+static void jdi_panel_del(struct jdi_panel *jdi)
+{
+	dev_info(&jdi->dsi->dev, "[jdi_panel_del]\n");
+	if (jdi->base.dev) {
+		dev_info(&jdi->dsi->dev, "[jdi_panel_del] calling drm_panel_remove.\n");
+		drm_panel_remove(&jdi->base);
+	} else {
+		dev_warn(&jdi->dsi->dev, "[jdi_panel_del] not calling drm_panel_remove.\n");
+	}
+}
+
+static int jdi_panel_probe(struct mipi_dsi_device *dsi)
+{
+	struct jdi_panel *jdi;
+	int ret;
+	int err;
+
+	dev_info(&dsi->dev, "[jdi_panel_probe] start...\n");
+
+	jdi = devm_drm_panel_alloc(&dsi->dev, struct jdi_panel, base,
+				   &jdi_panel_funcs, DRM_MODE_CONNECTOR_DSI);
+	if (IS_ERR(jdi))
+		return PTR_ERR(jdi);
+
+	dsi->lanes = 4;
+	dsi->format = MIPI_DSI_FMT_RGB888;
+	dsi->mode_flags = MIPI_DSI_MODE_VIDEO | MIPI_DSI_MODE_VIDEO_HSE;
+
+	// on a311d it works only without burst, but imx8mplus needs burst mode
+	if (of_property_present(dsi->dev.of_node, "burst-mode")) {
+		dsi->mode_flags |= MIPI_DSI_MODE_VIDEO_BURST;
+		dev_warn(&dsi->dev, "DSI burst mode enabled via device tree\n");
+	}
+	if (of_property_present(dsi->dev.of_node, "no-eot-hfp-hbp-hsa")) {
+		dsi->mode_flags |= MIPI_DSI_MODE_NO_EOT_PACKET | MIPI_DSI_MODE_VIDEO_NO_HFP | MIPI_DSI_MODE_VIDEO_NO_HBP | MIPI_DSI_MODE_VIDEO_NO_HSA;
+		dev_warn(&dsi->dev, "DSI eot/hfp/hbp/hsa disabled via device tree\n");
+	}
+
+	mipi_dsi_set_drvdata(dsi, jdi);
+	jdi->dsi = dsi;
+	jdi->panel_version = 0;
+	jdi->enabled = false;
+	jdi->prepared = false;
+
+	ret = jdi_panel_add(jdi);
+	dev_info(&dsi->dev, "[jdi_panel_probe] jdi_panel_add done.\n");
+	if (ret < 0) {
+		dev_err(&dsi->dev, "[jdi_panel_probe] error adding panel.\n");
+		return ret;
+	}
+
+	ret = mipi_dsi_attach(dsi);
+	if (ret < 0) {
+		dev_err(&dsi->dev, "[jdi_panel_probe] error attaching panel.\n");
+		jdi_panel_del(jdi);
+		return ret;
+	}
+
+	err = sysfs_create_group(&dsi->dev.kobj, &mnt_pocket_reform_panel_attr_group);
+	if (err) {
+		dev_err(&dsi->dev, "failed to register attr_group\n");
+	}
+
+	dev_info(&dsi->dev, "[jdi_panel_probe] done.\n");
+	return 0;
+}
+
+static void jdi_panel_shutdown(struct mipi_dsi_device *dsi);
+static void jdi_panel_remove(struct mipi_dsi_device *dsi)
+{
+	struct jdi_panel *jdi = mipi_dsi_get_drvdata(dsi);
+	int ret;
+
+	dev_info(&dsi->dev, "[jdi_panel_remove]\n");
+
+	sysfs_remove_group(&dsi->dev.kobj, &mnt_pocket_reform_panel_attr_group);
+
+	// BUG: dsi host doesn't seem to call shutdown on imx8mp
+	jdi_panel_shutdown(dsi);
+
+	ret = mipi_dsi_detach(dsi);
+	if (ret < 0)
+		dev_err(&dsi->dev, "failed to detach from DSI host: %d\n",
+			ret);
+
+	jdi_panel_del(jdi);
+}
+
+static void jdi_panel_shutdown(struct mipi_dsi_device *dsi)
+{
+	struct jdi_panel *jdi = mipi_dsi_get_drvdata(dsi);
+	dev_info(&dsi->dev, "[jdi_panel_shutdown]\n");
+
+	jdi_panel_disable(&jdi->base);
+	jdi_panel_unprepare(&jdi->base);
+}
+
+static struct mipi_dsi_driver jdi_panel_driver = {
+	.driver = {
+		.name = "panel-mnt-pocket-reform",
+		.of_match_table = jdi_of_match,
+	},
+	.probe = jdi_panel_probe,
+	.remove = jdi_panel_remove,
+	.shutdown = jdi_panel_shutdown,
+};
+module_mipi_dsi_driver(jdi_panel_driver);
