From c3471105820a52d7bd936c2999d7bab12271320f Mon Sep 17 00:00:00 2001
From: Stephano Cetola <stephano@cetola.net>
Date: Thu, 27 Aug 2026 09:54:40 -0700
Subject: [PATCH] qcacld2: fix build against kernel 7.2

cfg80211 removed WIPHY_FLAG_SUPPORTS_5_10_MHZ and added a MAC filter param to
remain_on_channel. Guard the flag, accept and ignore the new param.

Signed-off-by: Stephano Cetola <stephano@cetola.net>
---
 CORE/HDD/inc/wlan_hdd_p2p.h                   |  6 ++++-
 CORE/HDD/src/wlan_hdd_cfg80211.c              |  8 +++++++
 CORE/HDD/src/wlan_hdd_p2p.c                   | 24 ++++++++++++++++---
 CORE/SERVICES/HIF/common/hif_bmi_reg_access.c |  1 +
 4 files changed, 35 insertions(+), 4 deletions(-)

diff --git a/CORE/HDD/inc/wlan_hdd_p2p.h b/CORE/HDD/inc/wlan_hdd_p2p.h
index ab09991dd..aebbd76a3 100644
--- a/CORE/HDD/inc/wlan_hdd_p2p.h
+++ b/CORE/HDD/inc/wlan_hdd_p2p.h
@@ -110,7 +110,11 @@ int wlan_hdd_cfg80211_remain_on_channel( struct wiphy *wiphy,
 #if (LINUX_VERSION_CODE < KERNEL_VERSION(3,8,0)) && !defined(WITH_BACKPORTS)
                                 enum nl80211_channel_type channel_type,
 #endif
-                                unsigned int duration, u64 *cookie );
+                                unsigned int duration, u64 *cookie
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(7, 2, 0)
+                                , const u8 *rx_addr
+#endif
+                                );
 
 int wlan_hdd_cfg80211_cancel_remain_on_channel( struct wiphy *wiphy,
 #if (LINUX_VERSION_CODE >= KERNEL_VERSION(3,6,0)) || defined(WITH_BACKPORTS)
diff --git a/CORE/HDD/src/wlan_hdd_cfg80211.c b/CORE/HDD/src/wlan_hdd_cfg80211.c
index 0b75d939e..e21fc8955 100644
--- a/CORE/HDD/src/wlan_hdd_cfg80211.c
+++ b/CORE/HDD/src/wlan_hdd_cfg80211.c
@@ -16799,8 +16799,16 @@ int wlan_hdd_cfg80211_init(struct device *dev,
     wiphy->flags |= WIPHY_FLAG_HAS_CHANNEL_SWITCH;
 #endif
 
+#if LINUX_VERSION_CODE < KERNEL_VERSION(7, 2, 0)
+    /* wifi: cfg80211: remove 5/10 MHz channel support (upstream commit
+     * 1a15bf9708ba3, first in v7.2): WIPHY_FLAG_SUPPORTS_5_10_MHZ and
+     * 5/10 MHz channel width support were removed entirely, not renamed.
+     * cfg80211 now rejects any 5/10 MHz chandef unconditionally, so
+     * there is nothing left to flag on kernels that have this commit.
+     */
     if (pCfg->sub_20_channel_width)
         wiphy->flags |= WIPHY_FLAG_SUPPORTS_5_10_MHZ;
+#endif
 
     wiphy->features |= NL80211_FEATURE_INACTIVITY_TIMER;
 
diff --git a/CORE/HDD/src/wlan_hdd_p2p.c b/CORE/HDD/src/wlan_hdd_p2p.c
index c23066cee..60347a11e 100644
--- a/CORE/HDD/src/wlan_hdd_p2p.c
+++ b/CORE/HDD/src/wlan_hdd_p2p.c
@@ -1544,7 +1544,11 @@ int __wlan_hdd_cfg80211_remain_on_channel( struct wiphy *wiphy,
 #if (LINUX_VERSION_CODE < KERNEL_VERSION(3,8,0)) && !defined(WITH_BACKPORTS)
                                 enum nl80211_channel_type channel_type,
 #endif
-                                unsigned int duration, u64 *cookie )
+                                unsigned int duration, u64 *cookie
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(7, 2, 0)
+                                , const u8 *rx_addr
+#endif
+                                )
 {
 #if (LINUX_VERSION_CODE >= KERNEL_VERSION(3,6,0)) || defined(WITH_BACKPORTS)
     struct net_device *dev = wdev->netdev;
@@ -1555,6 +1559,12 @@ int __wlan_hdd_cfg80211_remain_on_channel( struct wiphy *wiphy,
 
     ENTER();
 
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(7, 2, 0)
+    /* MAC address filtering on remain-on-channel (cfg80211 commit
+     * 4dbd1829045ee, first in v7.2) is not implemented by this driver. */
+    (void)rx_addr;
+#endif
+
     if (VOS_FTM_MODE == hdd_get_conparam()) {
         hddLog(LOGE, FL("Command not allowed in FTM mode"));
         return -EINVAL;
@@ -1590,7 +1600,11 @@ int wlan_hdd_cfg80211_remain_on_channel( struct wiphy *wiphy,
 #if (LINUX_VERSION_CODE < KERNEL_VERSION(3,8,0)) && !defined(WITH_BACKPORTS)
                                 enum nl80211_channel_type channel_type,
 #endif
-                                unsigned int duration, u64 *cookie )
+                                unsigned int duration, u64 *cookie
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(7, 2, 0)
+                                , const u8 *rx_addr
+#endif
+                                )
 {
    int ret;
 
@@ -1605,7 +1619,11 @@ int wlan_hdd_cfg80211_remain_on_channel( struct wiphy *wiphy,
 #if (LINUX_VERSION_CODE < KERNEL_VERSION(3,8,0)) && !defined(WITH_BACKPORTS)
                                                channel_type,
 #endif
-                                               duration, cookie);
+                                               duration, cookie
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(7, 2, 0)
+                                               , rx_addr
+#endif
+                                               );
    vos_ssr_unprotect(__func__);
 
    return ret;
diff --git a/CORE/SERVICES/HIF/common/hif_bmi_reg_access.c b/CORE/SERVICES/HIF/common/hif_bmi_reg_access.c
index 2f393c21f..601b91426 100644
--- a/CORE/SERVICES/HIF/common/hif_bmi_reg_access.c
+++ b/CORE/SERVICES/HIF/common/hif_bmi_reg_access.c
@@ -32,6 +32,7 @@
 #include "hif.h"
 #include "bmi.h"
 #include "htc_api.h"
+#include <linux/mmc/sdio_func.h>
 #include "if_ath_sdio.h"
 #include "regtable.h"
 
-- 
2.47.3

