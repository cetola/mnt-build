diff --git a/arch/arm/boards/mnt-reform2-rk3588/defaultenv-mnt-pocket-reform-radxa-cm5/init/disp-reset b/arch/arm/boards/mnt-reform2-rk3588/defaultenv-mnt-pocket-reform-radxa-cm5/init/disp-reset
new file mode 100644
index 0000000000..314cb76f18
--- /dev/null
+++ b/arch/arm/boards/mnt-reform2-rk3588/defaultenv-mnt-pocket-reform-radxa-cm5/init/disp-reset
@@ -0,0 +1,21 @@
+#!/bin/sh
+# Pulse panel hardware RESX via the RP2040 system controller before autoboot.
+#
+# The RP2040 owns PIN_DISP_RESET (GPIO 2) and pulses it on cold boot, but not
+# on warm reboot. The 'r' SPI command triggers a 20ms active-low pulse, giving
+# the panel a clean reset regardless of how barebox was entered.
+#
+# The reform2_lpc protocol requires two separate SPI transactions with a 50ms
+# gap between them. Write and read must be separate calls: the RP2040 processes
+# the command in a timer interrupt after the first transaction completes, then
+# fills its TX FIFO with the response before the second transaction clocks it
+# out. A combined write+read in one transaction leaves no time for this and
+# the RP2040 sends zeros.
+#
+# Command: { 0xb5, 'r'=0x72, arg1=0x01, checksum=0xc6 }
+# checksum = 0xb5 ^ 0x72 ^ 0x01 = 0xc6
+# Response: 8 bytes (ignored); RESX pulse occurs after the response is sent.
+spi -b 0 -c 0 -m 1 -f 1000000 0xb5 0x72 0x01 0xc6
+msleep 50
+spi -b 0 -c 0 -m 1 -f 1000000 -r 8
+msleep 50
