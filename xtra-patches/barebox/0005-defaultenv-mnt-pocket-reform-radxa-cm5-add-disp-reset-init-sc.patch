From be356b0f187d7da27daeb2a8ea28e318428b1842 Mon Sep 17 00:00:00 2001
From: Stephano Cetola <stephano@cetola.net>
Date: Wed, 8 Jul 2026 17:30:00 -0800
Subject: [PATCH] defaultenv: mnt-pocket-reform-radxa-cm5: add disp-reset init
 script

Send a set-gpio command to the SC firmware at barebox startup. This
pulses the panel hardware RESX line (PIN_DISP_RESET, GPIO 2) before
autoboot.

The RP2040 pulses RESX on cold boot. It does not pulse RESX on warm
reboot. Without this pulse the Wisecoco V2 panel (ER88477) shows a
blank screen. DSI init races against an uninitialized panel. The JDI
V1 panel may also benefit from a clean reset on warm reboot.

We assert reset with "(set-gpio 0 0)". We release reset with
"(set-gpio 0 1)". Hold time is 20ms. This matches the SC firmware's
own cold-boot pulse width.

Write and read are separate SPI transactions with a 50ms gap. The
RP2040 processes the command in a timer interrupt after the write
transaction ends. It then fills its response buffer before the read
transaction. A combined write and read leaves no time for this. The
RP2040 sends zeros if we do not wait.

This script hardcodes bus 0. This matches this board's own spi_lpc
alias from patch 0004. Only boards with that node need this script.
The RCORE boards that share reform2_rk3588_probe() do not have it.

This script first lived in defaultenv-mnt-reform2-rk3588, the
directory shared by every board using that probe function. That
meant it would run on RCORE boards too. On those boards bus 0 is not
this board's RP2040. It could be any Rockchip SPI controller
depending on probe order. See patch 0006 for the bus numbering bug
this depends on.

We moved the script to a new board specific directory,
defaultenv-mnt-pocket-reform-radxa-cm5. We gated it behind a new
has_disp_reset_env field on struct reform2_model. Only this board
sets that field. So this script cannot run, and cannot touch
whatever is on bus 0, on any other board.

Depends on SC firmware with set-gpio command support.
Depends on the spi-gpio node in DTS added by patch 0004.

Signed-off-by: Stephano Cetola <stephano@cetola.net>
---
 arch/arm/boards/mnt-reform2-rk3588/Makefile   |  3 +-
 arch/arm/boards/mnt-reform2-rk3588/board.c    |  4 +++
 .../init/disp-reset                           | 29 +++++++++++++++++++
 3 files changed, 35 insertions(+), 1 deletion(-)
 create mode 100644 arch/arm/boards/mnt-reform2-rk3588/defaultenv-mnt-pocket-reform-radxa-cm5/init/disp-reset

diff --git a/arch/arm/boards/mnt-reform2-rk3588/Makefile b/arch/arm/boards/mnt-reform2-rk3588/Makefile
index 5e3732b4ae..d6d732af18 100644
--- a/arch/arm/boards/mnt-reform2-rk3588/Makefile
+++ b/arch/arm/boards/mnt-reform2-rk3588/Makefile
@@ -1,4 +1,5 @@
 # SPDX-License-Identifier: GPL-2.0-only
 obj-y += board.o
 lwl-y += lowlevel.o
-bbenv-y += defaultenv-mnt-reform2-rk3588
\ No newline at end of file
+bbenv-y += defaultenv-mnt-reform2-rk3588
+bbenv-y += defaultenv-mnt-pocket-reform-radxa-cm5
\ No newline at end of file
diff --git a/arch/arm/boards/mnt-reform2-rk3588/board.c b/arch/arm/boards/mnt-reform2-rk3588/board.c
index 69b73faeb7..f58e275a04 100644
--- a/arch/arm/boards/mnt-reform2-rk3588/board.c
+++ b/arch/arm/boards/mnt-reform2-rk3588/board.c
@@ -10,6 +10,7 @@
 struct reform2_model {
 	const char *name;
 	const char *shortname;
+	bool has_disp_reset_env;
 };
 
 /* GPIO GPIO4_B3 = E11 = (4*32 + 8 + 3) = 139 */
@@ -43,6 +44,8 @@ static int reform2_rk3588_probe(struct device *dev)
 	gpio_set_value(USB_HUB_RESET, 1);
 
 	defaultenv_append_directory(defaultenv_mnt_reform2_rk3588);
+	if (model->has_disp_reset_env)
+		defaultenv_append_directory(defaultenv_mnt_pocket_reform_radxa_cm5);
 
 	return 0;
 }
@@ -70,6 +73,7 @@ static const struct reform2_model reform_next_rk3588 = {
 static const struct reform2_model pocket_reform_radxa_cm5_rk3588s = {
 	.name = "MNT Pocket Reform with Radxa CM5 RK3588S2 Module",
 	.shortname = "pocket_reform_radxa_cm5_rk3588s",
+	.has_disp_reset_env = true,
 };
 
 static const struct of_device_id reform2_rk3588_of_match[] = {
diff --git a/arch/arm/boards/mnt-reform2-rk3588/defaultenv-mnt-pocket-reform-radxa-cm5/init/disp-reset b/arch/arm/boards/mnt-reform2-rk3588/defaultenv-mnt-pocket-reform-radxa-cm5/init/disp-reset
new file mode 100644
index 0000000000..b95af79753
--- /dev/null
+++ b/arch/arm/boards/mnt-reform2-rk3588/defaultenv-mnt-pocket-reform-radxa-cm5/init/disp-reset
@@ -0,0 +1,29 @@
+#!/bin/sh
+# Pulse panel hardware RESX via the RP2040 system controller before autoboot.
+#
+# The RP2040 owns PIN_DISP_RESET (GPIO 2). It pulses this pin on cold boot.
+# It does not pulse this pin on warm reboot. This script does that pulse.
+#
+# Write and read are separate SPI transactions with a 50ms gap. The RP2040
+# processes the command in a timer interrupt after the write transaction
+# ends. It then fills its response buffer before the read transaction. A
+# combined write and read does not give it time to do this. It would send
+# back zeros.
+#
+# The response is 8 bytes. We read it but ignore it.
+
+# assert reset
+spi -b 0 -c 0 -m 1 -f 1000000 0x28 0x73 0x65 0x74 0x2d 0x67 0x70 0x69
+msleep 1
+spi -b 0 -c 0 -m 1 -f 1000000 0x6f 0x20 0x30 0x20 0x30 0x29
+msleep 50
+spi -b 0 -c 0 -m 1 -f 1000000 -r 8
+msleep 50
+
+# release reset
+spi -b 0 -c 0 -m 1 -f 1000000 0x28 0x73 0x65 0x74 0x2d 0x67 0x70 0x69
+msleep 1
+spi -b 0 -c 0 -m 1 -f 1000000 0x6f 0x20 0x30 0x20 0x31 0x29
+msleep 50
+spi -b 0 -c 0 -m 1 -f 1000000 -r 8
+msleep 50
