From 77391e4fc1dfc32368033eb776a3ac2c3e7ebadb Mon Sep 17 00:00:00 2001
From: Stephano Cetola <stephano@cetola.net>
Date: Sat, 11 Jul 2026 19:03:04 +0000
Subject: arm: rk3588s: pocket-reform-radxa-cm5: enable DSI1 panel

Enable the MIPI DSI1 display pipeline in barebox for the Radxa CM5
(RK3588S2) board.

Add hdptxphy0, vop, vop_mmu, mipidcphy1, dsi1 (with JDI panel), the
VOP2 viewport endpoint (vp2 -> MIPI1 -> dsi1), and the
backlight-enable pinctrl group.

The vop node's clocks property already lists hdptxphy0 as
pll_hdmiphy0 (index 7) unconditionally in upstream rk3588-base.dtsi.
rockchip_drm_vop2.c's vop2_bind() does clk_get_optional(vop2->dev,
"pll_hdmiphy0") against that same node. With hdptxphy0 left disabled
that lookup can never resolve, so VOP2 probe defers forever. Enabling
hdptxphy0 here is what breaks the deferral. RK3588S has only
hdptxphy0 (no hdptxphy1 as on the full RK3588).

Signed-off-by: Stephano Cetola <stephano@cetola.net>
---
 .../rk3588s-mnt-pocket-reform-radxa-cm5.dts   | 65 +++++++++++++++++++
 1 file changed, 65 insertions(+)

diff --git a/arch/arm/dts/rk3588s-mnt-pocket-reform-radxa-cm5.dts b/arch/arm/dts/rk3588s-mnt-pocket-reform-radxa-cm5.dts
index 7b9fa6b301..bc701fe6e6 100644
--- a/arch/arm/dts/rk3588s-mnt-pocket-reform-radxa-cm5.dts
+++ b/arch/arm/dts/rk3588s-mnt-pocket-reform-radxa-cm5.dts
@@ -8,6 +8,7 @@
 
 #include <dt-bindings/gpio/gpio.h>
 #include <dt-bindings/pinctrl/rockchip.h>
+#include <dt-bindings/soc/rockchip,vop2.h>
 #include "arm64/rockchip/rk3588s.dtsi"
 #include "arm64/rockchip/rk3588s-radxa-cm5.dtsi"
 #include "rk3588.dtsi"
@@ -199,6 +200,70 @@ spi_lpc_pins: spi-lpc-pins {
 				<1 RK_PD4 RK_FUNC_GPIO &pcfg_pull_none>;
 		};
 	};
+
+	disp {
+		disp_en: disp-en {
+			rockchip,pins = <1 RK_PC2 RK_FUNC_GPIO &pcfg_pull_none>;
+		};
+	};
+};
+
+&hdptxphy0 {
+	status = "okay";
+};
+
+&vop_mmu {
+	status = "okay";
+};
+
+&vop {
+	status = "okay";
+};
+
+&mipidcphy1 {
+	status = "okay";
+};
+
+&dsi1 {
+	status = "okay";
+	rockchip,lane-rate = <972000>;
+
+	panel@0 {
+		compatible = "jdi,lt070me05000";
+		reg = <0>;
+
+		pinctrl-names = "default";
+		pinctrl-0 = <&disp_en>;
+
+		/* backlight enable; reset and DCDC are driven by the RP2040 */
+		enable-gpios = <&gpio1 RK_PC2 GPIO_ACTIVE_HIGH>;
+		probe-mode-lpm;
+
+		port {
+			mipi_panel_in: endpoint {
+				remote-endpoint = <&dsi1_out_panel>;
+			};
+		};
+	};
+};
+
+&dsi1_in {
+	dsi1_in_vp2: endpoint {
+		remote-endpoint = <&vp2_out_dsi1>;
+	};
+};
+
+&dsi1_out {
+	dsi1_out_panel: endpoint {
+		remote-endpoint = <&mipi_panel_in>;
+	};
+};
+
+&vp2 {
+	vp2_out_dsi1: endpoint@ROCKCHIP_VOP2_EP_MIPI1 {
+		reg = <ROCKCHIP_VOP2_EP_MIPI1>;
+		remote-endpoint = <&dsi1_in_vp2>;
+	};
 };
 
 /* Override the barebox rk3588.dtsi SCMI rates to also set SPLL to 702 MHz,
-- 
