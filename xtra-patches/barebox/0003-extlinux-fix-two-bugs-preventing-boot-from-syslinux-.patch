From a30a2258d57daed7db487a9a74d8f549bf42a7a2 Mon Sep 17 00:00:00 2001
From: Stephano Cetola <stephano@cetola.net>
Date: Wed, 8 Jul 2026 17:30:00 -0800
Subject: [PATCH 03/14] extlinux: fix two bugs preventing boot from
 syslinux-style extlinux.conf

Bug 1: LINUX keyword not recognised.
The extlinux spec (syslinux heritage) uses LINUX as the primary keyword
for a Linux kernel image. KERNEL is a generic keyword for any bootable
image. barebox's parser only matched KERNEL, following U-Boot's non-standard
convention. extlinux.conf files written by Debian, Arch, and MNT's own
linux-mnt-reform-bin all use the linux keyword, so entry->kernel was never
set and parse_extlinux_conf returned -EINVAL.
Fix: accept LINUX as an alias for KERNEL (case-insensitively), so both
the syslinux standard and the U-Boot convention work.

Bug 2: Absolute paths resolved relative to extlinux.conf directory.
entry->rootpath was set from dirname(abspath) (the directory containing
extlinux.conf, e.g. /mnt/boot/extlinux), not from the partition mount
root passed in as rootpath (e.g. /mnt). Absolute paths like /Image were
then built as /mnt/boot/extlinux//Image instead of /mnt/Image.
Fix: store rootpath (partition root) in entry->rootpath; introduce
extlinux_make_abs() to handle both leading-slash and relative paths.
---
 common/extlinux.c | 17 ++++++++++++-----
 1 file changed, 12 insertions(+), 5 deletions(-)

diff --git a/common/extlinux.c b/common/extlinux.c
index 0e838e9889..3419b734d4 100644
--- a/common/extlinux.c
+++ b/common/extlinux.c
@@ -54,6 +54,13 @@ static char *remove_param(const char *params, const char *param)
 	return result;
 }
 
+static char *extlinux_make_abs(const char *rootpath, const char *relpath)
+{
+	if (relpath[0] == '/')
+		return basprintf("%s%s", rootpath, relpath);
+	return basprintf("%s/%s", rootpath, relpath);
+}
+
 static int extlinux_boot(struct bootentry *be, int verbose, int dryrun)
 {
 	struct extlinux_entry *e =
@@ -67,18 +74,18 @@ static int extlinux_boot(struct bootentry *be, int verbose, int dryrun)
 	data.dryrun = max_t(int, dryrun, data.dryrun);
 	data.verbose = max(verbose, data.verbose);
 
-	kernel_abs = basprintf("%s/%s", e->rootpath, e->kernel);
+	kernel_abs = extlinux_make_abs(e->rootpath, e->kernel);
 	data.os_file = kernel_abs;
 
 	if (e->initrd) {
-		initrd_abs = basprintf("%s/%s", e->rootpath, e->initrd);
+		initrd_abs = extlinux_make_abs(e->rootpath, e->initrd);
 		data.initrd_file = initrd_abs;
 	}
 
 	if (e->fdt) {
 		char *fdtdir = e->fdtdir ? : e->rootpath;
 
-		fdt_abs = basprintf("%s/%s", fdtdir, e->fdt);
+		fdt_abs = extlinux_make_abs(fdtdir, e->fdt);
 		data.oftree_file = fdt_abs;
 	}
 
@@ -164,7 +171,7 @@ static struct extlinux_entry *parse_extlinux_conf(const char *abspath,
 			if (!strcmp(val, default_label)) {
 				entry = xzalloc(sizeof(*entry));
 				entry->label = xstrdup(val);
-				entry->rootpath = dirname(xstrdup(abspath));
+				entry->rootpath = xstrdup(rootpath);
 			} else if (entry) {
 				break;
 			}
@@ -172,7 +179,7 @@ static struct extlinux_entry *parse_extlinux_conf(const char *abspath,
 		}
 
 		if (entry) {
-			if (!strcasecmp(key, "KERNEL"))
+			if (!strcasecmp(key, "KERNEL") || !strcasecmp(key, "LINUX"))
 				entry->kernel = xstrdup(val);
 			else if (!strcasecmp(key, "INITRD"))
 				entry->initrd = xstrdup(val);
