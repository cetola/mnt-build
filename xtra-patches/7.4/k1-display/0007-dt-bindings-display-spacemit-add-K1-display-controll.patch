From 42f6ab8c4e3dedf1657acd2cea1e139461927c0f Mon Sep 17 00:00:00 2001
From: Stephano Cetola <stephano@cetola.net>
Date: Fri, 27 Nov 2026 23:49:59 +0000
Subject: [PATCH] dt-bindings: display: spacemit: add K1 display controller

Describe the display controller that feeds the DSI host of the SpacemiT
K1 SoC.

Signed-off-by: Stephano Cetola <stephano@cetola.net>
---
 .../display/spacemit/spacemit,k1-dpu.yaml     | 102 ++++++++++++++++++
 1 file changed, 102 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/display/spacemit/spacemit,k1-dpu.yaml

diff --git a/Documentation/devicetree/bindings/display/spacemit/spacemit,k1-dpu.yaml b/Documentation/devicetree/bindings/display/spacemit/spacemit,k1-dpu.yaml
new file mode 100644
index 0000000000000..8d0f7db6bd373
--- /dev/null
+++ b/Documentation/devicetree/bindings/display/spacemit/spacemit,k1-dpu.yaml
@@ -0,0 +1,102 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/display/spacemit/spacemit,k1-dpu.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: SpacemiT K1 display controller
+
+maintainers:
+  - Stephano Cetola <stephano@cetola.net>
+
+description:
+  The display controller of the SpacemiT K1 SoC reads framebuffers from
+  memory, composes them and produces the pixel stream consumed by the MIPI
+  DSI host controller.
+
+properties:
+  compatible:
+    const: spacemit,k1-dpu
+
+  reg:
+    maxItems: 1
+
+  interrupts:
+    maxItems: 1
+    description: Interrupt of the online (display) pipelines
+
+  clocks:
+    items:
+      - description: Pixel clock
+      - description: Controller core clock
+      - description: Register bus clock
+      - description: Escape clock
+
+  clock-names:
+    items:
+      - const: pixel
+      - const: core
+      - const: bus
+      - const: esc
+
+  resets:
+    items:
+      - description: MIPI DSI reset
+      - description: Register bus reset
+      - description: Controller core reset
+      - description: Escape clock domain reset
+
+  reset-names:
+    items:
+      - const: mipi
+      - const: bus
+      - const: core
+      - const: esc
+
+  power-domains:
+    maxItems: 1
+
+  port:
+    $ref: /schemas/graph.yaml#/properties/port
+    description: Pixel output to the DSI host controller
+
+required:
+  - compatible
+  - reg
+  - interrupts
+  - clocks
+  - clock-names
+  - resets
+  - reset-names
+  - power-domains
+  - port
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/clock/spacemit,k1-syscon.h>
+    #include <dt-bindings/power/spacemit,k1-power.h>
+
+    display-controller@c0340000 {
+        compatible = "spacemit,k1-dpu";
+        reg = <0xc0340000 0x2a000>;
+        interrupts = <90>;
+        clocks = <&syscon_apmu CLK_DPU_PXCLK>,
+                 <&syscon_apmu CLK_DPU_MCLK>,
+                 <&syscon_apmu CLK_DPU_HCLK>,
+                 <&syscon_apmu CLK_DPU_ESC>;
+        clock-names = "pixel", "core", "bus", "esc";
+        resets = <&syscon_apmu RESET_MIPI>,
+                 <&syscon_apmu RESET_DPU_HCLK>,
+                 <&syscon_apmu RESET_DPU_MCLK>,
+                 <&syscon_apmu RESET_DPU_ESC>;
+        reset-names = "mipi", "bus", "core", "esc";
+        power-domains = <&syscon_apmu K1_PMDOMAIN_LCD>;
+
+        port {
+            endpoint {
+                remote-endpoint = <&dsi_in>;
+            };
+        };
+    };
