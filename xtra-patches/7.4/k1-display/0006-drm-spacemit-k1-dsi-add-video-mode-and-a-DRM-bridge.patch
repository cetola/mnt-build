From 5c33b0fd76a9cbe45793d402aa46839b62a86eed Mon Sep 17 00:00:00 2001
From: Stephano Cetola <stephano@cetola.net>
Date: Fri, 27 Nov 2026 23:35:01 +0000
Subject: [PATCH] drm/spacemit: k1-dsi: add video mode and a DRM bridge

Register a DRM bridge once a panel attaches, and stream video in burst
mode when it is enabled. Video is paused around each command, because a
command sent while it is enabled does not complete. Do the vendor driver's writes to the two
registers outside the host when the link comes up.

The register values computed for the 1200x1920 panel match those read
from the vendor driver on the same hardware.

Signed-off-by: Stephano Cetola <stephano@cetola.net>
---
 drivers/gpu/drm/spacemit/Kconfig           |   5 +-
 drivers/gpu/drm/spacemit/spacemit-k1-dsi.c | 311 ++++++++++++++++++++-
 2 files changed, 303 insertions(+), 13 deletions(-)

diff --git a/drivers/gpu/drm/spacemit/Kconfig b/drivers/gpu/drm/spacemit/Kconfig
index 43bc82e8f4120..cd3b5d6b4c047 100644
--- a/drivers/gpu/drm/spacemit/Kconfig
+++ b/drivers/gpu/drm/spacemit/Kconfig
@@ -4,12 +4,13 @@ config DRM_SPACEMIT_K1_DSI
 	depends on DRM && OF
 	depends on ARCH_SPACEMIT || COMPILE_TEST
 	select CRC_CCITT
+	select DRM_KMS_HELPER
 	select DRM_MIPI_DSI
 	select GENERIC_PHY
 	select GENERIC_PHY_MIPI_DPHY
 	help
 	  Support for the MIPI DSI host controller of the SpacemiT K1 SoC.
-	  The driver currently sends and receives DSI commands only, so a
-	  panel attached to it can be configured but shows no picture.
+	  It sends DSI commands and acts as a DRM bridge for burst mode
+	  video. A picture also needs a display controller driver.
 
 	  If built as a module, it is called spacemit-k1-dsi.
diff --git a/drivers/gpu/drm/spacemit/spacemit-k1-dsi.c b/drivers/gpu/drm/spacemit/spacemit-k1-dsi.c
index 368299f2430da..e3812a181a6b8 100644
--- a/drivers/gpu/drm/spacemit/spacemit-k1-dsi.c
+++ b/drivers/gpu/drm/spacemit/spacemit-k1-dsi.c
@@ -2,8 +2,6 @@
 /*
  * SpacemiT K1 MIPI DSI host controller driver
  *
- * So far this only sends and receives commands. There is no video mode.
- *
  * Register layout and programming sequences are taken from the SpacemiT vendor
  * kernel.
  *
@@ -18,6 +16,7 @@
 #include <linux/delay.h>
 #include <linux/io.h>
 #include <linux/iopoll.h>
+#include <linux/math64.h>
 #include <linux/module.h>
 #include <linux/mutex.h>
 #include <linux/phy/phy.h>
@@ -27,11 +26,20 @@
 #include <linux/reset.h>
 #include <linux/unaligned.h>
 
+#include <drm/drm_atomic.h>
+#include <drm/drm_atomic_helper.h>
+#include <drm/drm_atomic_state_helper.h>
+#include <drm/drm_bridge.h>
 #include <drm/drm_mipi_dsi.h>
+#include <drm/drm_modes.h>
 
 #include <video/mipi_display.h>
 
 #define K1_DSI_CTRL_0			0x000
+#define  K1_DSI_CTRL_0_VPN_EN		BIT(0)
+#define  K1_DSI_CTRL_0_CPN_EN		BIT(2)
+#define  K1_DSI_CTRL_0_VPN_SLAVE	BIT(4)
+#define  K1_DSI_CTRL_0_VPN_TX_EN	BIT(8)
 #define  K1_DSI_CTRL_0_RESET		(GENMASK(31, 26) | GENMASK(24, 23))
 
 #define K1_DSI_CTRL_1			0x004
@@ -71,27 +79,77 @@
 
 #define K1_DSI_LCD_BDG_CTRL0		0x084
 #define  K1_DSI_LCD_BDG_CTRL0_SPLIT_EN	BIT(0)
+#define  K1_DSI_LCD_BDG_CTRL0_PIXEL_SWAP	BIT(1)
+#define  K1_DSI_LCD_BDG_CTRL0_AFULL_BYPASS	BIT(6)
+#define  K1_DSI_LCD_BDG_CTRL0_AFULL_COUNT	GENMASK(27, 16)
+
+#define K1_DSI_VPN_CTRL_0		0x100
+/* Purpose unknown; the vendor driver always writes this value. */
+#define  K1_DSI_VPN_CTRL_0_VALUE	0x00500c08
+
+#define K1_DSI_VPN_CTRL_1		0x104
+#define  K1_DSI_VPN_CTRL_1_RGB_TYPE	GENMASK(1, 0)
+#define  K1_DSI_VPN_CTRL_1_RGB888	3
+#define  K1_DSI_VPN_CTRL_1_MODE		GENMASK(3, 2)
+#define  K1_DSI_VPN_CTRL_1_BURST	2
+#define  K1_DSI_VPN_CTRL_1_HBP_PKT_EN	BIT(18)
+#define  K1_DSI_VPN_CTRL_1_HACT_WC_EN	BIT(26)
+#define  K1_DSI_VPN_CTRL_1_VSYNC_RST_EN	BIT(31)
+
+/* Each of these holds two values, in bytes per lane or in lines. */
+#define K1_DSI_VPN_TIMING_0		0x110	/* hactive, htotal */
+#define K1_DSI_VPN_TIMING_1		0x114	/* hsync, hback porch */
+#define K1_DSI_VPN_TIMING_2		0x118	/* vactive, vtotal */
+#define K1_DSI_VPN_TIMING_3		0x11c	/* vsync, vback porch */
+/* Packet word counts, in bytes. */
+#define K1_DSI_VPN_WC_0			0x120	/* hback porch, hsync */
+#define K1_DSI_VPN_WC_1			0x124	/* hfront porch, hactive */
+#define K1_DSI_VPN_WC_2			0x128	/* low power */
+#define K1_DSI_VPN_SLOT_CNT_0		0x130
+#define K1_DSI_VPN_SLOT_CNT_1		0x134
+
+#define  K1_DSI_HIGH			GENMASK(31, 16)
+#define  K1_DSI_LOW			GENMASK(15, 0)
+
+/* Registers outside the host that connect the display controller to it. */
+#define K1_DSI_PATH_CTRL_0		0x00
+#define  K1_DSI_PATH_CTRL_0_VALUE	0x40000001
+#define K1_DSI_PATH_CTRL_1		0x10
+#define  K1_DSI_PATH_CTRL_1_VALUE	0x00000001
+
+/* Bytes of a long packet that are not payload, as counted by the hardware. */
+#define K1_DSI_SYNC_START_BYTES		4
+#define K1_DSI_PACKET_OVERHEAD		6
+#define K1_DSI_BYTES_PER_PIXEL		3
 
 #define K1_DSI_MAX_LANES		4
 #define K1_DSI_TX_FIFO_SIZE		256
 #define K1_DSI_RX_FIFO_SIZE		64
 #define K1_DSI_PACKET_CRC_SIZE		2
-/* Used until a video mode provides a pixel clock to derive the rate from. */
-#define K1_DSI_COMMAND_HS_RATE		1000000000UL
+/*
+ * Bit rate of each lane, for commands and for burst mode video. It is the rate
+ * the vendor kernel uses with the only panel tested.
+ */
+#define K1_DSI_HS_RATE			1000000000UL
+/* Longer than one frame at 50 Hz or more. */
+#define K1_DSI_FRAME_MS			20
 
 struct k1_dsi {
 	struct device *dev;
 	void __iomem *base;
+	void __iomem *path;
+	struct drm_bridge bridge;
 	struct mipi_dsi_host host;
 	struct clk_bulk_data clks[3];
 	struct reset_control *resets;
 	struct phy *phy;
-	/* Protects the link state and serializes transfers. */
+	/* Protects the link and video state and serializes transfers. */
 	struct mutex lock;
 	unsigned int lanes;
 	unsigned long mode_flags;
 	bool attached;
 	bool link_up;
+	bool video_on;
 };
 
 static inline struct k1_dsi *host_to_k1_dsi(struct mipi_dsi_host *host)
@@ -99,6 +157,11 @@ static inline struct k1_dsi *host_to_k1_dsi(struct mipi_dsi_host *host)
 	return container_of(host, struct k1_dsi, host);
 }
 
+static inline struct k1_dsi *bridge_to_k1_dsi(struct drm_bridge *bridge)
+{
+	return container_of(bridge, struct k1_dsi, bridge);
+}
+
 /* Error correction code of a packet header, MIPI DSI specification. */
 static u8 k1_dsi_ecc(const u8 *header)
 {
@@ -132,6 +195,9 @@ static int k1_dsi_link_up(struct k1_dsi *dsi)
 	if (ret)
 		goto err_reset;
 
+	writel(K1_DSI_PATH_CTRL_0_VALUE, dsi->path + K1_DSI_PATH_CTRL_0);
+	writel(K1_DSI_PATH_CTRL_1_VALUE, dsi->path + K1_DSI_PATH_CTRL_1);
+
 	writel(K1_DSI_CTRL_0_RESET, dsi->base + K1_DSI_CTRL_0);
 	usleep_range(1000, 2000);
 	writel(0, dsi->base + K1_DSI_CTRL_0);
@@ -141,7 +207,7 @@ static int k1_dsi_link_up(struct k1_dsi *dsi)
 	if (ret)
 		goto err_clk;
 
-	ret = phy_mipi_dphy_get_default_config_for_hsclk(K1_DSI_COMMAND_HS_RATE,
+	ret = phy_mipi_dphy_get_default_config_for_hsclk(K1_DSI_HS_RATE,
 							 dsi->lanes,
 							 &opts.mipi_dphy);
 	if (ret)
@@ -198,6 +264,7 @@ static void k1_dsi_link_down(struct k1_dsi *dsi)
 	reset_control_assert(dsi->resets);
 	pm_runtime_put_sync(dsi->dev);
 	dsi->link_up = false;
+	dsi->video_on = false;
 }
 
 static int k1_dsi_write_fifo(struct k1_dsi *dsi, const u8 *buf, size_t len)
@@ -363,6 +430,26 @@ static ssize_t k1_dsi_receive(struct k1_dsi *dsi, const struct mipi_dsi_msg *msg
 	return len;
 }
 
+/*
+ * A command sent while the video engine is enabled does not complete, so it is
+ * switched off around each transfer.
+ */
+static void k1_dsi_video_pause(struct k1_dsi *dsi)
+{
+	writel(readl(dsi->base + K1_DSI_CTRL_0) &
+	       ~(K1_DSI_CTRL_0_VPN_TX_EN | K1_DSI_CTRL_0_VPN_EN),
+	       dsi->base + K1_DSI_CTRL_0);
+	/* Let a frame that is being sent finish. */
+	msleep(K1_DSI_FRAME_MS);
+}
+
+static void k1_dsi_video_resume(struct k1_dsi *dsi)
+{
+	writel(readl(dsi->base + K1_DSI_CTRL_0) |
+	       K1_DSI_CTRL_0_VPN_TX_EN | K1_DSI_CTRL_0_VPN_EN,
+	       dsi->base + K1_DSI_CTRL_0);
+}
+
 static ssize_t k1_dsi_host_transfer(struct mipi_dsi_host *host,
 				    const struct mipi_dsi_msg *msg)
 {
@@ -380,24 +467,203 @@ static ssize_t k1_dsi_host_transfer(struct mipi_dsi_host *host,
 			return ret;
 	}
 
+	if (dsi->video_on)
+		k1_dsi_video_pause(dsi);
+
 	ret = k1_dsi_send(dsi, msg);
 	if (!ret)
 		ret = msg->rx_len ? k1_dsi_receive(dsi, msg) : msg->tx_len;
 
 	/*
 	 * A transfer that did not complete leaves the controller busy. Reset
-	 * it, so that the next transfer starts from a clean state.
+	 * it, so that the next transfer starts from a clean state, unless that
+	 * would stop the video stream.
 	 */
-	if (ret < 0)
+	if (dsi->video_on)
+		k1_dsi_video_resume(dsi);
+	else if (ret < 0)
 		k1_dsi_link_down(dsi);
 
 	return ret;
 }
 
+static u32 k1_dsi_pair(u32 high, u32 low)
+{
+	return FIELD_PREP(K1_DSI_HIGH, high) | FIELD_PREP(K1_DSI_LOW, low);
+}
+
+static void k1_dsi_video_start(struct k1_dsi *dsi,
+			       const struct drm_display_mode *mode)
+{
+	unsigned int bpp = K1_DSI_BYTES_PER_PIXEL;
+	unsigned int lanes = dsi->lanes;
+	u32 hact, hfp, hsync, hbp, htotal, vsync, vbp, slots, val;
+
+	/* Horizontal timings in bytes, over all lanes. */
+	hact = mode->hdisplay * bpp;
+	hfp = (mode->hsync_start - mode->hdisplay) * bpp;
+	hsync = (mode->hsync_end - mode->hsync_start) * bpp;
+	hbp = (mode->htotal - mode->hsync_end) * bpp;
+	htotal = mode->htotal * bpp;
+	vsync = mode->vsync_end - mode->vsync_start;
+	vbp = mode->vtotal - mode->vsync_end;
+	slots = (htotal - hact) / lanes + 3;
+
+	writel(K1_DSI_VPN_CTRL_0_VALUE, dsi->base + K1_DSI_VPN_CTRL_0);
+
+	writel(k1_dsi_pair(hact / lanes, htotal / lanes),
+	       dsi->base + K1_DSI_VPN_TIMING_0);
+	writel(k1_dsi_pair(hsync / lanes, hbp / lanes),
+	       dsi->base + K1_DSI_VPN_TIMING_1);
+	writel(k1_dsi_pair(mode->vdisplay, mode->vtotal),
+	       dsi->base + K1_DSI_VPN_TIMING_2);
+	writel(k1_dsi_pair(vsync, vbp), dsi->base + K1_DSI_VPN_TIMING_3);
+
+	/* In burst mode the sync pulse is merged into the back porch. */
+	writel(k1_dsi_pair(hsync + hbp - K1_DSI_SYNC_START_BYTES -
+			   K1_DSI_PACKET_OVERHEAD, 0),
+	       dsi->base + K1_DSI_VPN_WC_0);
+	writel(k1_dsi_pair(hfp - 2 * K1_DSI_PACKET_OVERHEAD, hact),
+	       dsi->base + K1_DSI_VPN_WC_1);
+	writel(htotal - K1_DSI_SYNC_START_BYTES - K1_DSI_PACKET_OVERHEAD,
+	       dsi->base + K1_DSI_VPN_WC_2);
+
+	writel(k1_dsi_pair(slots, slots), dsi->base + K1_DSI_VPN_SLOT_CNT_0);
+	writel(k1_dsi_pair(slots, slots), dsi->base + K1_DSI_VPN_SLOT_CNT_1);
+
+	writel(K1_DSI_VPN_CTRL_1_VSYNC_RST_EN |
+	       K1_DSI_VPN_CTRL_1_HACT_WC_EN |
+	       K1_DSI_VPN_CTRL_1_HBP_PKT_EN |
+	       FIELD_PREP(K1_DSI_VPN_CTRL_1_MODE, K1_DSI_VPN_CTRL_1_BURST) |
+	       FIELD_PREP(K1_DSI_VPN_CTRL_1_RGB_TYPE, K1_DSI_VPN_CTRL_1_RGB888),
+	       dsi->base + K1_DSI_VPN_CTRL_1);
+
+	val = readl(dsi->base + K1_DSI_LCD_BDG_CTRL0);
+	val &= ~K1_DSI_LCD_BDG_CTRL0_AFULL_COUNT;
+	val |= K1_DSI_LCD_BDG_CTRL0_AFULL_BYPASS |
+	       K1_DSI_LCD_BDG_CTRL0_PIXEL_SWAP;
+	writel(val, dsi->base + K1_DSI_LCD_BDG_CTRL0);
+
+	val = readl(dsi->base + K1_DSI_CTRL_0);
+	val &= ~K1_DSI_CTRL_0_CPN_EN;
+	val |= K1_DSI_CTRL_0_VPN_TX_EN | K1_DSI_CTRL_0_VPN_SLAVE |
+	       K1_DSI_CTRL_0_VPN_EN;
+	writel(val, dsi->base + K1_DSI_CTRL_0);
+
+	dsi->video_on = true;
+}
+
+static void k1_dsi_video_stop(struct k1_dsi *dsi)
+{
+	if (!dsi->video_on)
+		return;
+
+	writel(readl(dsi->base + K1_DSI_CTRL_0) &
+	       ~(K1_DSI_CTRL_0_VPN_TX_EN | K1_DSI_CTRL_0_VPN_EN),
+	       dsi->base + K1_DSI_CTRL_0);
+	dsi->video_on = false;
+}
+
+static int k1_dsi_bridge_attach(struct drm_bridge *bridge,
+				struct drm_encoder *encoder,
+				enum drm_bridge_attach_flags flags)
+{
+	return drm_bridge_attach(encoder, bridge->next_bridge, bridge, flags);
+}
+
+static enum drm_mode_status
+k1_dsi_bridge_mode_valid(struct drm_bridge *bridge,
+			 const struct drm_display_info *info,
+			 const struct drm_display_mode *mode)
+{
+	struct k1_dsi *dsi = bridge_to_k1_dsi(bridge);
+	unsigned int bpp = K1_DSI_BYTES_PER_PIXEL;
+	unsigned int hfp = mode->hsync_start - mode->hdisplay;
+	unsigned int hblank = mode->htotal - mode->hsync_start;
+
+	/* Burst mode needs a link at least as fast as the pixel stream. */
+	if (div_u64(mode->clock * 1000ULL * bpp * 8, dsi->lanes) >
+	    K1_DSI_HS_RATE)
+		return MODE_CLOCK_HIGH;
+
+	/* The porches must hold the packet overhead taken out of them. */
+	if (hfp * bpp <= 2 * K1_DSI_PACKET_OVERHEAD ||
+	    hblank * bpp <= K1_DSI_SYNC_START_BYTES + K1_DSI_PACKET_OVERHEAD)
+		return MODE_HBLANK_NARROW;
+
+	return MODE_OK;
+}
+
+static void k1_dsi_bridge_atomic_pre_enable(struct drm_bridge *bridge,
+					    struct drm_atomic_commit *state)
+{
+	struct k1_dsi *dsi = bridge_to_k1_dsi(bridge);
+
+	guard(mutex)(&dsi->lock);
+
+	if (!dsi->link_up)
+		k1_dsi_link_up(dsi);
+}
+
+static void k1_dsi_bridge_atomic_enable(struct drm_bridge *bridge,
+					struct drm_atomic_commit *state)
+{
+	struct k1_dsi *dsi = bridge_to_k1_dsi(bridge);
+	struct drm_connector_state *conn_state;
+	struct drm_crtc_state *crtc_state;
+	struct drm_connector *connector;
+
+	connector = drm_atomic_get_new_connector_for_encoder(state,
+							     bridge->encoder);
+	conn_state = drm_atomic_get_new_connector_state(state, connector);
+	crtc_state = drm_atomic_get_new_crtc_state(state, conn_state->crtc);
+
+	guard(mutex)(&dsi->lock);
+
+	/* A command may have failed and reset the link since pre_enable. */
+	if (!dsi->link_up && k1_dsi_link_up(dsi))
+		return;
+
+	k1_dsi_video_start(dsi, &crtc_state->adjusted_mode);
+}
+
+static void k1_dsi_bridge_atomic_disable(struct drm_bridge *bridge,
+					 struct drm_atomic_commit *state)
+{
+	struct k1_dsi *dsi = bridge_to_k1_dsi(bridge);
+
+	guard(mutex)(&dsi->lock);
+
+	k1_dsi_video_stop(dsi);
+}
+
+static void k1_dsi_bridge_atomic_post_disable(struct drm_bridge *bridge,
+					      struct drm_atomic_commit *state)
+{
+	struct k1_dsi *dsi = bridge_to_k1_dsi(bridge);
+
+	guard(mutex)(&dsi->lock);
+
+	k1_dsi_link_down(dsi);
+}
+
+static const struct drm_bridge_funcs k1_dsi_bridge_funcs = {
+	.attach = k1_dsi_bridge_attach,
+	.mode_valid = k1_dsi_bridge_mode_valid,
+	.atomic_pre_enable = k1_dsi_bridge_atomic_pre_enable,
+	.atomic_enable = k1_dsi_bridge_atomic_enable,
+	.atomic_disable = k1_dsi_bridge_atomic_disable,
+	.atomic_post_disable = k1_dsi_bridge_atomic_post_disable,
+	.atomic_create_state = drm_atomic_helper_bridge_create_state,
+	.atomic_duplicate_state = drm_atomic_helper_bridge_duplicate_state,
+	.atomic_destroy_state = drm_atomic_helper_bridge_destroy_state,
+};
+
 static int k1_dsi_host_attach(struct mipi_dsi_host *host,
 			      struct mipi_dsi_device *device)
 {
 	struct k1_dsi *dsi = host_to_k1_dsi(host);
+	struct drm_bridge *next;
 
 	guard(mutex)(&dsi->lock);
 
@@ -407,9 +673,22 @@ static int k1_dsi_host_attach(struct mipi_dsi_host *host,
 	if (!device->lanes || device->lanes > K1_DSI_MAX_LANES)
 		return -EINVAL;
 
+	/* Only this combination has been worked out. */
+	if (device->format != MIPI_DSI_FMT_RGB888 ||
+	    !(device->mode_flags & MIPI_DSI_MODE_VIDEO_BURST)) {
+		dev_err(dsi->dev, "only RGB888 burst mode is supported\n");
+		return -EINVAL;
+	}
+
+	next = of_drm_get_bridge_by_endpoint(dsi->dev->of_node, 1, 0);
+	if (IS_ERR(next))
+		return PTR_ERR(next);
+
+	dsi->bridge.next_bridge = next;
 	dsi->lanes = device->lanes;
 	dsi->mode_flags = device->mode_flags;
 	dsi->attached = true;
+	drm_bridge_add(&dsi->bridge);
 
 	return 0;
 }
@@ -419,9 +698,12 @@ static int k1_dsi_host_detach(struct mipi_dsi_host *host,
 {
 	struct k1_dsi *dsi = host_to_k1_dsi(host);
 
+	drm_bridge_remove(&dsi->bridge);
+
 	guard(mutex)(&dsi->lock);
 
 	k1_dsi_link_down(dsi);
+	drm_bridge_clear_and_put(&dsi->bridge.next_bridge);
 	dsi->attached = false;
 
 	return 0;
@@ -439,11 +721,14 @@ static int k1_dsi_probe(struct platform_device *pdev)
 	struct k1_dsi *dsi;
 	int ret;
 
-	dsi = devm_kzalloc_obj(dev, *dsi);
-	if (!dsi)
-		return -ENOMEM;
+	dsi = devm_drm_bridge_alloc(dev, struct k1_dsi, bridge,
+				    &k1_dsi_bridge_funcs);
+	if (IS_ERR(dsi))
+		return PTR_ERR(dsi);
 
 	dsi->dev = dev;
+	dsi->bridge.of_node = dev->of_node;
+	dsi->bridge.type = DRM_MODE_CONNECTOR_DSI;
 	platform_set_drvdata(pdev, dsi);
 
 	ret = devm_mutex_init(dev, &dsi->lock);
@@ -454,6 +739,10 @@ static int k1_dsi_probe(struct platform_device *pdev)
 	if (IS_ERR(dsi->base))
 		return PTR_ERR(dsi->base);
 
+	dsi->path = devm_platform_ioremap_resource(pdev, 1);
+	if (IS_ERR(dsi->path))
+		return PTR_ERR(dsi->path);
+
 	dsi->clks[0].id = "bus";
 	dsi->clks[1].id = "core";
 	dsi->clks[2].id = "esc";
