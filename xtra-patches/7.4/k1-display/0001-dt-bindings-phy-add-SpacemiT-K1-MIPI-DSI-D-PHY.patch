From 86374580937c0969c47abd7440907163030fae89 Mon Sep 17 00:00:00 2001
From: Stephano Cetola <stephano@cetola.net>
Date: Fri, 27 Nov 2026 21:05:16 +0000
Subject: [PATCH 1/2] dt-bindings: phy: add SpacemiT K1 MIPI DSI D-PHY

Describe the transmit-only MIPI D-PHY behind the DSI host controller of
the SpacemiT K1 SoC. Its registers directly follow those of the host
controller.

Signed-off-by: Stephano Cetola <stephano@cetola.net>
---
 .../bindings/phy/spacemit,k1-mipi-dphy.yaml   | 73 +++++++++++++++++++
 1 file changed, 73 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/phy/spacemit,k1-mipi-dphy.yaml

diff --git a/Documentation/devicetree/bindings/phy/spacemit,k1-mipi-dphy.yaml b/Documentation/devicetree/bindings/phy/spacemit,k1-mipi-dphy.yaml
new file mode 100644
index 0000000000000..d60f2b4902da8
--- /dev/null
+++ b/Documentation/devicetree/bindings/phy/spacemit,k1-mipi-dphy.yaml
@@ -0,0 +1,73 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/phy/spacemit,k1-mipi-dphy.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: SpacemiT K1 MIPI DSI D-PHY
+
+maintainers:
+  - Stephano Cetola <stephano@cetola.net>
+
+description:
+  Transmit-only MIPI D-PHY with up to four data lanes, used by the DSI host
+  controller of the SpacemiT K1 SoC. Its registers directly follow those of
+  the DSI host controller.
+
+properties:
+  compatible:
+    const: spacemit,k1-mipi-dphy
+
+  reg:
+    maxItems: 1
+
+  clocks:
+    items:
+      - description: Register bus clock
+      - description: Escape clock, the unit of the PHY timing registers
+      - description: High-speed clock, one cycle per bit on each data lane
+
+  clock-names:
+    items:
+      - const: bus
+      - const: esc
+      - const: hs
+
+  resets:
+    maxItems: 1
+
+  power-domains:
+    maxItems: 1
+
+  avdd12-supply:
+    description: 1.2 V analog supply of the PHY
+
+  "#phy-cells":
+    const: 0
+
+required:
+  - compatible
+  - reg
+  - clocks
+  - clock-names
+  - resets
+  - avdd12-supply
+  - "#phy-cells"
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/clock/spacemit,k1-syscon.h>
+
+    phy@d421a980 {
+        compatible = "spacemit,k1-mipi-dphy";
+        reg = <0xd421a980 0x80>;
+        clocks = <&syscon_apmu CLK_DPU_HCLK>,
+                 <&syscon_apmu CLK_DPU_ESC>,
+                 <&syscon_apmu CLK_DPU_BIT>;
+        clock-names = "bus", "esc", "hs";
+        resets = <&syscon_apmu RESET_MIPI>;
+        avdd12-supply = <&reg_dsi_1v2>;
+        #phy-cells = <0>;
+    };
