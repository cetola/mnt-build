From cccda5ffb7d758260b209512c5391e3083732208 Mon Sep 17 00:00:00 2001
From: Stephano Cetola <stephano@cetola.net>
Date: Fri, 27 Nov 2026 21:56:50 +0000
Subject: [PATCH 3/5] dt-bindings: display: spacemit: add K1 MIPI DSI host

Describe the DSI host controller of the SpacemiT K1 SoC.

Signed-off-by: Stephano Cetola <stephano@cetola.net>
---
 .../spacemit/spacemit,k1-mipi-dsi.yaml        | 128 ++++++++++++++++++
 1 file changed, 128 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/display/spacemit/spacemit,k1-mipi-dsi.yaml

diff --git a/Documentation/devicetree/bindings/display/spacemit/spacemit,k1-mipi-dsi.yaml b/Documentation/devicetree/bindings/display/spacemit/spacemit,k1-mipi-dsi.yaml
new file mode 100644
index 0000000000000..e4a7994957dd8
--- /dev/null
+++ b/Documentation/devicetree/bindings/display/spacemit/spacemit,k1-mipi-dsi.yaml
@@ -0,0 +1,128 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/display/spacemit/spacemit,k1-mipi-dsi.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: SpacemiT K1 MIPI DSI host controller
+
+maintainers:
+  - Stephano Cetola <stephano@cetola.net>
+
+allOf:
+  - $ref: /schemas/display/dsi-controller.yaml#
+
+properties:
+  compatible:
+    const: spacemit,k1-mipi-dsi
+
+  reg:
+    items:
+      - description: DSI host controller registers
+      - description: Registers that route the display controller to the host
+
+  clocks:
+    items:
+      - description: Register bus clock
+      - description: Controller core clock
+      - description: Escape clock
+
+  clock-names:
+    items:
+      - const: bus
+      - const: core
+      - const: esc
+
+  resets:
+    items:
+      - description: MIPI DSI reset
+      - description: Register bus reset
+      - description: Controller core reset
+      - description: Escape clock domain reset
+
+  reset-names:
+    items:
+      - const: mipi
+      - const: bus
+      - const: core
+      - const: esc
+
+  power-domains:
+    maxItems: 1
+
+  phys:
+    maxItems: 1
+
+  phy-names:
+    const: dphy
+
+  ports:
+    $ref: /schemas/graph.yaml#/properties/ports
+
+    properties:
+      port@0:
+        $ref: /schemas/graph.yaml#/properties/port
+        description: Pixel input from the display controller
+
+      port@1:
+        $ref: /schemas/graph.yaml#/properties/port
+        description: Output to the panel or bridge
+
+    required:
+      - port@0
+      - port@1
+
+required:
+  - compatible
+  - reg
+  - clocks
+  - clock-names
+  - resets
+  - reset-names
+  - power-domains
+  - phys
+  - phy-names
+  - ports
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/clock/spacemit,k1-syscon.h>
+    #include <dt-bindings/power/spacemit,k1-power.h>
+
+    dsi@d421a800 {
+        compatible = "spacemit,k1-mipi-dsi";
+        reg = <0xd421a800 0x180>, <0xd421a1a8 0x14>;
+        clocks = <&syscon_apmu CLK_DPU_HCLK>,
+                 <&syscon_apmu CLK_DPU_MCLK>,
+                 <&syscon_apmu CLK_DPU_ESC>;
+        clock-names = "bus", "core", "esc";
+        resets = <&syscon_apmu RESET_MIPI>,
+                 <&syscon_apmu RESET_DPU_HCLK>,
+                 <&syscon_apmu RESET_DPU_MCLK>,
+                 <&syscon_apmu RESET_DPU_ESC>;
+        reset-names = "mipi", "bus", "core", "esc";
+        power-domains = <&syscon_apmu K1_PMDOMAIN_LCD>;
+        phys = <&mipi_dphy>;
+        phy-names = "dphy";
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        ports {
+            #address-cells = <1>;
+            #size-cells = <0>;
+
+            port@0 {
+                reg = <0>;
+            };
+
+            port@1 {
+                reg = <1>;
+
+                endpoint {
+                    remote-endpoint = <&panel_in>;
+                };
+            };
+        };
+    };
