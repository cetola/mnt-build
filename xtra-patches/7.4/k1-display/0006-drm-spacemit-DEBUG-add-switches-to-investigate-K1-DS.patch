From c50ec81e00450f601e372b1a2a42384fd7c7a083 Mon Sep 17 00:00:00 2001
From: Stephano Cetola <stephano@cetola.net>
Date: Fri, 27 Nov 2026 23:10:58 +0000
Subject: [PATCH] drm/spacemit: DEBUG: add switches to investigate K1 DSI reads

Module parameters change the escape and core clock rates, enable the DPU
pixel clock and do the vendor's two "online setup" writes. They take
effect the next time the link is brought up. Not for upstream.

Signed-off-by: Stephano Cetola <stephano@cetola.net>
---
 drivers/gpu/drm/spacemit/spacemit-k1-dsi.c | 69 ++++++++++++++++++++++
 1 file changed, 69 insertions(+)

diff --git a/drivers/gpu/drm/spacemit/spacemit-k1-dsi.c b/drivers/gpu/drm/spacemit/spacemit-k1-dsi.c
index 368299f2430da..3a67508b52c3f 100644
--- a/drivers/gpu/drm/spacemit/spacemit-k1-dsi.c
+++ b/drivers/gpu/drm/spacemit/spacemit-k1-dsi.c
@@ -20,6 +20,8 @@
 #include <linux/iopoll.h>
 #include <linux/module.h>
 #include <linux/mutex.h>
+#include <linux/of.h>
+#include <linux/of_clk.h>
 #include <linux/phy/phy.h>
 #include <linux/phy/phy-mipi-dphy.h>
 #include <linux/platform_device.h>
@@ -31,6 +33,8 @@
 
 #include <video/mipi_display.h>
 
+#include <dt-bindings/clock/spacemit,k1-syscon.h>
+
 #define K1_DSI_CTRL_0			0x000
 #define  K1_DSI_CTRL_0_RESET		(GENMASK(31, 26) | GENMASK(24, 23))
 
@@ -79,8 +83,19 @@
 /* Used until a video mode provides a pixel clock to derive the rate from. */
 #define K1_DSI_COMMAND_HS_RATE		1000000000UL
 
+/* Temporary switches to find out what reads need. Applied at link bring-up. */
+static ulong debug_esc_hz;
+module_param(debug_esc_hz, ulong, 0644);
+static ulong debug_core_hz;
+module_param(debug_core_hz, ulong, 0644);
+static bool debug_pixel_clock;
+module_param(debug_pixel_clock, bool, 0644);
+static bool debug_online_setup;
+module_param(debug_online_setup, bool, 0644);
+
 struct k1_dsi {
 	struct device *dev;
+	struct clk *pixel_clk;
 	void __iomem *base;
 	struct mipi_dsi_host host;
 	struct clk_bulk_data clks[3];
@@ -115,6 +130,56 @@ static u8 k1_dsi_ecc(const u8 *header)
 	return ecc;
 }
 
+static void k1_dsi_debug_setup(struct k1_dsi *dsi)
+{
+	struct of_phandle_args args = { .args_count = 1,
+					.args = { CLK_DPU_PXCLK } };
+	void __iomem *online;
+	struct clk *clk;
+
+	if (debug_esc_hz)
+		clk_set_rate(dsi->clks[2].clk, debug_esc_hz);
+	if (debug_core_hz)
+		clk_set_rate(dsi->clks[1].clk, debug_core_hz);
+
+	if (debug_pixel_clock) {
+		args.np = of_find_compatible_node(NULL, NULL,
+						  "spacemit,k1-syscon-apmu");
+		clk = of_clk_get_from_provider(&args);
+		of_node_put(args.np);
+		if (!IS_ERR(clk) && !clk_prepare_enable(clk))
+			dsi->pixel_clk = clk;
+		else
+			dev_err(dsi->dev, "debug: no pixel clock\n");
+	}
+
+	if (debug_online_setup) {
+		/* Written by the vendor driver before it opens the host. */
+		online = ioremap(0xd421a1a8, 0x14);
+		if (online) {
+			writel(0x40000001, online);
+			writel(0x1, online + 0x10);
+			iounmap(online);
+		}
+	}
+
+	dev_info(dsi->dev, "debug: esc %lu, core %lu, pixel %lu, online %d\n",
+		 clk_get_rate(dsi->clks[2].clk),
+		 clk_get_rate(dsi->clks[1].clk),
+		 dsi->pixel_clk ? clk_get_rate(dsi->pixel_clk) : 0,
+		 debug_online_setup);
+}
+
+static void k1_dsi_debug_teardown(struct k1_dsi *dsi)
+{
+	if (!dsi->pixel_clk)
+		return;
+
+	clk_disable_unprepare(dsi->pixel_clk);
+	clk_put(dsi->pixel_clk);
+	dsi->pixel_clk = NULL;
+}
+
 static int k1_dsi_link_up(struct k1_dsi *dsi)
 {
 	union phy_configure_opts opts = { };
@@ -132,6 +197,8 @@ static int k1_dsi_link_up(struct k1_dsi *dsi)
 	if (ret)
 		goto err_reset;
 
+	k1_dsi_debug_setup(dsi);
+
 	writel(K1_DSI_CTRL_0_RESET, dsi->base + K1_DSI_CTRL_0);
 	usleep_range(1000, 2000);
 	writel(0, dsi->base + K1_DSI_CTRL_0);
@@ -177,6 +244,7 @@ static int k1_dsi_link_up(struct k1_dsi *dsi)
 err_phy_exit:
 	phy_exit(dsi->phy);
 err_clk:
+	k1_dsi_debug_teardown(dsi);
 	clk_bulk_disable_unprepare(ARRAY_SIZE(dsi->clks), dsi->clks);
 err_reset:
 	reset_control_assert(dsi->resets);
@@ -194,6 +262,7 @@ static void k1_dsi_link_down(struct k1_dsi *dsi)
 
 	phy_power_off(dsi->phy);
 	phy_exit(dsi->phy);
+	k1_dsi_debug_teardown(dsi);
 	clk_bulk_disable_unprepare(ARRAY_SIZE(dsi->clks), dsi->clks);
 	reset_control_assert(dsi->resets);
 	pm_runtime_put_sync(dsi->dev);
