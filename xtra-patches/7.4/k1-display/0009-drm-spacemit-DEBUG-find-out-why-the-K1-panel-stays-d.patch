From fa0c152140c2c441f9594e1603f83cf508f9d5b9 Mon Sep 17 00:00:00 2001
From: Stephano Cetola <stephano@cetola.net>
Date: Sat, 28 Nov 2026 00:36:35 +0000
Subject: [PATCH] drm/spacemit: DEBUG: find out why the K1 panel stays dark

Default to no EoTP packet and a 76.8 MHz escape clock, as the vendor
driver does. Add switches for those, for the background colour and for
leaving the plane off, and debugfs files that dump the DSI and display
controller registers. Not for upstream.

Signed-off-by: Stephano Cetola <stephano@cetola.net>
---
 drivers/gpu/drm/spacemit/spacemit-k1-dpu.c | 57 ++++++++++++++++++-
 drivers/gpu/drm/spacemit/spacemit-k1-dsi.c | 64 +++++++++++++++++++++-
 2 files changed, 116 insertions(+), 5 deletions(-)

diff --git a/drivers/gpu/drm/spacemit/spacemit-k1-dpu.c b/drivers/gpu/drm/spacemit/spacemit-k1-dpu.c
index da135b4dec5a2..da01218724ba9 100644
--- a/drivers/gpu/drm/spacemit/spacemit-k1-dpu.c
+++ b/drivers/gpu/drm/spacemit/spacemit-k1-dpu.c
@@ -17,6 +17,7 @@
 #include <linux/bitfield.h>
 #include <linux/bits.h>
 #include <linux/clk.h>
+#include <linux/debugfs.h>
 #include <linux/dma-mapping.h>
 #include <linux/interrupt.h>
 #include <linux/io.h>
@@ -26,6 +27,7 @@
 #include <linux/platform_device.h>
 #include <linux/pm_runtime.h>
 #include <linux/reset.h>
+#include <linux/seq_file.h>
 
 #include <drm/clients/drm_client_setup.h>
 #include <drm/drm_atomic.h>
@@ -209,7 +211,17 @@ enum k1_dpu_clk {
 	K1_DPU_NUM_CLKS,
 };
 
+/*
+ * Temporary: colour shown where no plane covers the screen, as 0xRRGGBB, and
+ * a switch to leave the plane off so that this colour fills the screen.
+ */
+static uint debug_background;
+module_param(debug_background, uint, 0644);
+static bool debug_no_plane;
+module_param(debug_no_plane, bool, 0644);
+
 struct k1_dpu {
+	struct dentry *debugfs;
 	struct drm_device drm;
 	struct drm_plane plane;
 	struct drm_crtc crtc;
@@ -295,9 +307,9 @@ static void k1_dpu_init_output(struct k1_dpu *dpu,
 	u32 size = k1_dpu_xy(mode->vdisplay, mode->hdisplay);
 
 	/* Black where no layer covers the screen. */
-	k1_dpu_write(dpu, cmp + K1_DPU_CMP_BG_R, 0);
-	k1_dpu_write(dpu, cmp + K1_DPU_CMP_BG_G, 0);
-	k1_dpu_write(dpu, cmp + K1_DPU_CMP_BG_B, 0);
+	k1_dpu_write(dpu, cmp + K1_DPU_CMP_BG_R, (debug_background >> 16) & 0xff);
+	k1_dpu_write(dpu, cmp + K1_DPU_CMP_BG_G, (debug_background >> 8) & 0xff);
+	k1_dpu_write(dpu, cmp + K1_DPU_CMP_BG_B, debug_background & 0xff);
 	k1_dpu_write(dpu, cmp + K1_DPU_CMP_BG_A, 0xff);
 	k1_dpu_write(dpu, cmp + K1_DPU_CMP_CTRL,
 		     K1_DPU_CMP_CTRL_EN |
@@ -528,6 +540,12 @@ static void k1_dpu_plane_atomic_update(struct drm_plane *plane,
 				K1_DPU_LAYER_BLEND_PREMULTI));
 	k1_dpu_rmw(dpu, layer + K1_DPU_LAYER_ALPHA, K1_DPU_LAYER_ALPHA_PLANE,
 		   FIELD_PREP(K1_DPU_LAYER_ALPHA_PLANE, 0xff));
+	drm_info_once(&dpu->drm, "debug: scanout address %pad\n", &addr);
+	if (debug_no_plane) {
+		k1_dpu_write(dpu, layer + K1_DPU_LAYER_CTRL, 0);
+		return;
+	}
+
 	k1_dpu_write(dpu, layer + K1_DPU_LAYER_CTRL,
 		     K1_DPU_LAYER_CTRL_EN |
 		     FIELD_PREP(K1_DPU_LAYER_CTRL_CHANNEL,
@@ -806,6 +824,35 @@ static int k1_dpu_modeset_init(struct k1_dpu *dpu, struct drm_bridge *bridge)
 	return 0;
 }
 
+static int k1_dpu_regs_show(struct seq_file *s, void *unused)
+{
+	static const struct {
+		const char *name;
+		u32 start, end;
+	} blocks[] = {
+		{ "dpu-top", 0x0000, 0x0a00 }, { "dpu-dma", 0x0a00, 0x2000 },
+		{ "dpu-lp", 0x2000, 0x4600 }, { "dpu-cmp", 0x4600, 0x5200 },
+		{ "dpu-out2", 0x18000, 0x18800 },
+	};
+	struct k1_dpu *dpu = s->private;
+	unsigned int i;
+	u32 off;
+
+	/* Reading an unpowered controller hangs the bus. */
+	if (!dpu->powered) {
+		seq_puts(s, "powered off\n");
+		return 0;
+	}
+
+	for (i = 0; i < ARRAY_SIZE(blocks); i++)
+		for (off = blocks[i].start; off < blocks[i].end; off += 4)
+			seq_printf(s, "%-9s 0x%08x 0x%08x\n", blocks[i].name,
+				   0xc0340000 + off, k1_dpu_read(dpu, off));
+
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(k1_dpu_regs);
+
 static int k1_dpu_probe(struct platform_device *pdev)
 {
 	struct device *dev = &pdev->dev;
@@ -867,6 +914,9 @@ static int k1_dpu_probe(struct platform_device *pdev)
 	if (ret)
 		return ret;
 
+	dpu->debugfs = debugfs_create_file("k1-dpu-regs", 0400, NULL, dpu,
+					   &k1_dpu_regs_fops);
+
 	drm_client_setup(&dpu->drm, NULL);
 
 	return 0;
@@ -876,6 +926,7 @@ static void k1_dpu_remove(struct platform_device *pdev)
 {
 	struct k1_dpu *dpu = platform_get_drvdata(pdev);
 
+	debugfs_remove(dpu->debugfs);
 	drm_dev_unregister(&dpu->drm);
 	drm_atomic_helper_shutdown(&dpu->drm);
 }
diff --git a/drivers/gpu/drm/spacemit/spacemit-k1-dsi.c b/drivers/gpu/drm/spacemit/spacemit-k1-dsi.c
index e3812a181a6b8..bd249e637070e 100644
--- a/drivers/gpu/drm/spacemit/spacemit-k1-dsi.c
+++ b/drivers/gpu/drm/spacemit/spacemit-k1-dsi.c
@@ -13,6 +13,7 @@
 #include <linux/bitops.h>
 #include <linux/clk.h>
 #include <linux/crc-ccitt.h>
+#include <linux/debugfs.h>
 #include <linux/delay.h>
 #include <linux/io.h>
 #include <linux/iopoll.h>
@@ -24,6 +25,7 @@
 #include <linux/platform_device.h>
 #include <linux/pm_runtime.h>
 #include <linux/reset.h>
+#include <linux/seq_file.h>
 #include <linux/unaligned.h>
 
 #include <drm/drm_atomic.h>
@@ -134,8 +136,17 @@
 /* Longer than one frame at 50 Hz or more. */
 #define K1_DSI_FRAME_MS			20
 
+/* Temporary switches. The defaults match what the vendor driver does. */
+static bool debug_eotp;
+module_param(debug_eotp, bool, 0644);
+static ulong debug_esc_hz = 76800000;
+module_param(debug_esc_hz, ulong, 0644);
+
 struct k1_dsi {
 	struct device *dev;
+	void __iomem *debug_phy;
+	void __iomem *debug_apmu;
+	struct dentry *debugfs;
 	void __iomem *base;
 	void __iomem *path;
 	struct drm_bridge bridge;
@@ -195,6 +206,11 @@ static int k1_dsi_link_up(struct k1_dsi *dsi)
 	if (ret)
 		goto err_reset;
 
+	if (debug_esc_hz)
+		clk_set_rate(dsi->clks[2].clk, debug_esc_hz);
+	dev_info(dsi->dev, "debug: esc %lu Hz, EoTP %d\n",
+		 clk_get_rate(dsi->clks[2].clk), debug_eotp);
+
 	writel(K1_DSI_PATH_CTRL_0_VALUE, dsi->path + K1_DSI_PATH_CTRL_0);
 	writel(K1_DSI_PATH_CTRL_1_VALUE, dsi->path + K1_DSI_PATH_CTRL_1);
 
@@ -231,8 +247,7 @@ static int k1_dsi_link_up(struct k1_dsi *dsi)
 	writel(FIELD_PREP(K1_DSI_CPU_CMD_1_LP_LANES, GENMASK(dsi->lanes - 1, 0)),
 	       dsi->base + K1_DSI_CPU_CMD_1);
 	writel((readl(dsi->base + K1_DSI_CTRL_1) & ~K1_DSI_CTRL_1_EOTP_EN) |
-	       (dsi->mode_flags & MIPI_DSI_MODE_NO_EOT_PACKET ?
-		0 : K1_DSI_CTRL_1_EOTP_EN),
+	       (debug_eotp ? K1_DSI_CTRL_1_EOTP_EN : 0),
 	       dsi->base + K1_DSI_CTRL_1);
 
 	dsi->link_up = true;
@@ -715,6 +730,41 @@ static const struct mipi_dsi_host_ops k1_dsi_host_ops = {
 	.transfer = k1_dsi_host_transfer,
 };
 
+static void k1_dsi_debug_range(struct seq_file *s, const char *name,
+			       void __iomem *va, u32 phys, u32 len)
+{
+	u32 off;
+
+	for (off = 0; off < len; off += 4)
+		seq_printf(s, "%-9s 0x%08x 0x%08x\n", name, phys + off,
+			   readl(va + off));
+}
+
+static int k1_dsi_regs_show(struct seq_file *s, void *unused)
+{
+	struct k1_dsi *dsi = s->private;
+
+	guard(mutex)(&dsi->lock);
+
+	k1_dsi_debug_range(s, "apmu", dsi->debug_apmu + 0x44, 0xd4282844, 0xc);
+	/* The rest hangs the bus while the link is down. */
+	if (!dsi->link_up) {
+		seq_puts(s, "link down\n");
+		return 0;
+	}
+	k1_dsi_debug_range(s, "dsi-dphy", dsi->base, 0xd421a800, 0x180);
+	k1_dsi_debug_range(s, "dsi-dphy", dsi->debug_phy, 0xd421a980, 0x80);
+	k1_dsi_debug_range(s, "path", dsi->path, 0xd421a1a8, 0x14);
+
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(k1_dsi_regs);
+
+static void k1_dsi_debug_remove(void *data)
+{
+	debugfs_remove(data);
+}
+
 static int k1_dsi_probe(struct platform_device *pdev)
 {
 	struct device *dev = &pdev->dev;
@@ -765,6 +815,16 @@ static int k1_dsi_probe(struct platform_device *pdev)
 	if (ret)
 		return ret;
 
+	dsi->debug_phy = devm_ioremap(dev, 0xd421a980, 0x80);
+	dsi->debug_apmu = devm_ioremap(dev, 0xd4282800, 0x100);
+	if (!dsi->debug_phy || !dsi->debug_apmu)
+		return -ENOMEM;
+	dsi->debugfs = debugfs_create_file("k1-dsi-regs", 0400, NULL, dsi,
+					   &k1_dsi_regs_fops);
+	ret = devm_add_action_or_reset(dev, k1_dsi_debug_remove, dsi->debugfs);
+	if (ret)
+		return ret;
+
 	/* The hardware is left alone until the first transfer. */
 	dsi->host.dev = dev;
 	dsi->host.ops = &k1_dsi_host_ops;
