+static int k1_dpu_modeset_init(struct k1_dpu *dpu, struct drm_bridge *bridge)
+{
+	static const u32 formats[] = { DRM_FORMAT_XRGB8888 };
+	struct drm_device *drm = &dpu->drm;
+	struct drm_connector *connector;
+	int ret;
+
+	ret = drmm_mode_config_init(drm);
+	if (ret)
+		return ret;
+
+	drm->mode_config.min_width = 1;
+	drm->mode_config.min_height = 1;
+	drm->mode_config.max_width = K1_DPU_MAX_WIDTH;
+	drm->mode_config.max_height = K1_DPU_MAX_HEIGHT;
+	drm->mode_config.funcs = &k1_dpu_mode_config_funcs;
+	drm->mode_config.helper_private = &k1_dpu_mode_config_helpers;
+
+	ret = drm_universal_plane_init(drm, &dpu->plane, 0,
+				       &k1_dpu_plane_funcs, formats,
+				       ARRAY_SIZE(formats), NULL,
+				       DRM_PLANE_TYPE_PRIMARY, NULL);
+	if (ret)
+		return ret;
+	drm_plane_helper_add(&dpu->plane, &k1_dpu_plane_helper_funcs);
+
+	ret = drm_crtc_init_with_planes(drm, &dpu->crtc, &dpu->plane, NULL,
+					&k1_dpu_crtc_funcs, NULL);
+	if (ret)
+		return ret;
+	drm_crtc_helper_add(&dpu->crtc, &k1_dpu_crtc_helper_funcs);
+
+	ret = drm_encoder_init(drm, &dpu->encoder, &k1_dpu_encoder_funcs,
+			       DRM_MODE_ENCODER_DSI, NULL);
+	if (ret)
+		return ret;
+	dpu->encoder.possible_crtcs = drm_crtc_mask(&dpu->crtc);
+
+	ret = drm_bridge_attach(&dpu->encoder, bridge, NULL,
+				DRM_BRIDGE_ATTACH_NO_CONNECTOR);
+	if (ret)
+		return ret;
+
+	connector = drm_bridge_connector_init(drm, &dpu->encoder);
+	if (IS_ERR(connector))
+		return PTR_ERR(connector);
+
+	ret = drm_connector_attach_encoder(connector, &dpu->encoder);
+	if (ret)
+		return ret;
+
+	ret = drm_vblank_init(drm, 1);
+	if (ret)
+		return ret;
+
+	drm_mode_config_reset(drm);
+
+	return 0;
+}
+
+static int k1_dpu_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct k1_dpu *dpu;
+	int ret;
+
+	struct drm_bridge *bridge __free(drm_bridge_put) =
+		of_drm_get_bridge_by_endpoint(dev->of_node, 0, 0);
+	if (IS_ERR(bridge))
+		return dev_err_probe(dev, PTR_ERR(bridge),
+				     "failed to find the DSI bridge\n");
+
+	dpu = devm_drm_dev_alloc(dev, &k1_dpu_driver, struct k1_dpu, drm);
+	if (IS_ERR(dpu))
+		return PTR_ERR(dpu);
+	platform_set_drvdata(pdev, dpu);
+
+	dpu->base = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(dpu->base))
+		return PTR_ERR(dpu->base);
+
+	dpu->clks[K1_DPU_CLK_PIXEL].id = "pixel";
+	dpu->clks[K1_DPU_CLK_CORE].id = "core";
+	dpu->clks[K1_DPU_CLK_BUS].id = "bus";
+	dpu->clks[K1_DPU_CLK_ESC].id = "esc";
+	ret = devm_clk_bulk_get(dev, K1_DPU_NUM_CLKS, dpu->clks);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to get clocks\n");
+
+	/* Shared with the DSI host and the D-PHY. */
+	dpu->resets = devm_reset_control_array_get_shared(dev);
+	if (IS_ERR(dpu->resets))
+		return dev_err_probe(dev, PTR_ERR(dpu->resets),
+				     "failed to get resets\n");
+
+	/* The high address register only holds two bits. */
+	ret = dma_set_mask_and_coherent(dev, DMA_BIT_MASK(32));
+	if (ret)
+		return ret;
+
+	/* The line is only enabled while the controller is powered. */
+	dpu->irq = platform_get_irq(pdev, 0);
+	if (dpu->irq < 0)
+		return dpu->irq;
+	ret = devm_request_irq(dev, dpu->irq, k1_dpu_irq, IRQF_NO_AUTOEN,
+			       dev_name(dev), dpu);
+	if (ret)
+		return ret;
+
+	ret = devm_pm_runtime_enable(dev);
+	if (ret)
+		return ret;
+
+	ret = k1_dpu_modeset_init(dpu, bridge);
+	if (ret)
+		return ret;
+
+	ret = drm_dev_register(&dpu->drm, 0);
+	if (ret)
+		return ret;
+
+	drm_client_setup(&dpu->drm, NULL);
+
+	return 0;
+}
+
+static void k1_dpu_remove(struct platform_device *pdev)
+{
+	struct k1_dpu *dpu = platform_get_drvdata(pdev);
+
+	drm_dev_unregister(&dpu->drm);
+	drm_atomic_helper_shutdown(&dpu->drm);
+}
