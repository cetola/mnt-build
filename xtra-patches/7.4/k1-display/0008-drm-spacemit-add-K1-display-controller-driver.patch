+/* Planes are programmed after the CRTC and the bridges are enabled. */
+static const struct drm_mode_config_helper_funcs k1_dpu_mode_config_helpers = {
+	.atomic_commit_tail = drm_atomic_helper_commit_tail_rpm,
+};
