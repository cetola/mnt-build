From 712d4831d9ba945dac17a98e09f1d75fc3433a2a Mon Sep 17 00:00:00 2001
From: Stephano Cetola <stephano@cetola.net>
Date: Thu, 18 Jun 2026 15:41:12 -0700
Subject: [PATCH] fixup! drm/bridge-connector: Switch to .detect_ctx() for
 connector detection

---
 drivers/gpu/drm/display/drm_bridge_connector.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/drivers/gpu/drm/display/drm_bridge_connector.c b/drivers/gpu/drm/display/drm_bridge_connector.c
index 4bdaa269b05c..b43baa04b7ef 100644
--- a/drivers/gpu/drm/display/drm_bridge_connector.c
+++ b/drivers/gpu/drm/display/drm_bridge_connector.c
@@ -296,11 +296,11 @@ static int drm_bridge_connector_detect_ctx(struct drm_connector *connector,
 static int drm_bridge_connector_get_modes_edid(struct drm_connector *connector,
 					       struct drm_bridge *bridge)
 {
-	enum drm_connector_status status;
+	int status;
 	const struct drm_edid *drm_edid;
 	int n;
 
-	status = drm_bridge_connector_detect(connector, false);
+	status = drm_bridge_connector_detect_ctx(connector, NULL, false);
 	if (status != connector_status_connected)
 		goto no_edid;
 
-- 
2.47.3

