+static int jdi_generic_write(struct jdi_panel *jdi, const void *data, size_t len, const char *tag)
+{
+	const u8 *buf = data;
+	char bytes[64] = { 0 };
+	int pos = 0;
+	size_t i;
+	int ret;
+
+	for (i = 0; i < min_t(size_t, len, 8); i++)
+		pos += scnprintf(bytes + pos, sizeof(bytes) - pos, "%s%02x", i ? " " : "", buf[i]);
+
+	jdi_trace(jdi, __func__, "generic tx tag=%s len=%zu bytes=%s",
+		  tag ? tag : "generic", len, bytes[0] ? bytes : "<empty>");
+
+	ret = mipi_dsi_generic_write(jdi->dsi, data, len);
+	if (ret < 0)
+		dev_err(&jdi->dsi->dev, "[display generic] %s failed: %d\n",
+			tag ? tag : "generic", ret);
+	else
+		jdi_trace(jdi, __func__, "generic tx complete tag=%s ret=%d",
+			  tag ? tag : "generic", ret);
+
+	return ret;
+}
+
+static int jdi_dcs_write1(struct jdi_panel *jdi, u8 cmd, u8 val, const char *tag)
+{
+	int ret;
+
+	jdi_trace(jdi, __func__, "dcs write tag=%s cmd=0x%02x val=0x%02x",
+		  tag ? tag : "dcs", cmd, val);
+	ret = mipi_dsi_dcs_write(jdi->dsi, cmd, &val, 1);
+	if (ret < 0)
+		dev_err(&jdi->dsi->dev, "[display dcs] %s failed: %d\n",
+			tag ? tag : "dcs", ret);
+	else
+		jdi_trace(jdi, __func__, "dcs write complete tag=%s ret=%d",
+			  tag ? tag : "dcs", ret);
+
+	return ret;
+}
