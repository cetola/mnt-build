+static void jdi_trace(struct jdi_panel *jdi, const char *func, const char *fmt, ...)
+{
+	struct device *dev = &jdi->dsi->dev;
+	va_list args;
+	char msg[256];
+
+	va_start(args, fmt);
+	vscnprintf(msg, sizeof(msg), fmt, args);
+	va_end(args);
+
+	dev_info(dev, "[display trace #%u +%ums] %s: %s\n",
+		 ++jdi->trace_seq, jiffies_to_msecs(jiffies), func, msg);
+}
+
+static const char *jdi_bool(bool v)
+{
+	return v ? "true" : "false";
+}
+
+static void jdi_format_mode_flags(unsigned long flags, char *buf, size_t len)
+{
+	scnprintf(buf, len,
+		  "0x%lx%s%s%s%s%s%s%s%s",
+		  flags,
+		  (flags & MIPI_DSI_MODE_VIDEO) ? " VIDEO" : "",
+		  (flags & MIPI_DSI_MODE_VIDEO_BURST) ? " BURST" : "",
+		  (flags & MIPI_DSI_MODE_VIDEO_HSE) ? " HSE" : "",
+		  (flags & MIPI_DSI_MODE_LPM) ? " LPM" : "",
+		  (flags & MIPI_DSI_MODE_NO_EOT_PACKET) ? " NO_EOT" : "",
+		  (flags & MIPI_DSI_MODE_VIDEO_NO_HFP) ? " NO_HFP" : "",
+		  (flags & MIPI_DSI_MODE_VIDEO_NO_HBP) ? " NO_HBP" : "",
+		  (flags & MIPI_DSI_MODE_VIDEO_NO_HSA) ? " NO_HSA" : "");
+}
+
+static int jdi_gpio_state(struct gpio_desc *gpio)
+{
+	if (IS_ERR(gpio))
+		return PTR_ERR(gpio);
+
+	return gpiod_get_value_cansleep(gpio);
+}
+
+static bool jdi_regulator_enabled(struct regulator_bulk_data *supply)
+{
+	if (!supply->consumer)
+		return false;
+
+	return regulator_is_enabled(supply->consumer) > 0;
+}
+
+static void jdi_dump_supplies(struct jdi_panel *jdi, const char *where)
+{
+	jdi_trace(jdi, where, "supplies: %s=%s %s=%s",
+		jdi->supplies[0].supply, jdi_bool(jdi_regulator_enabled(&jdi->supplies[0])),
+		jdi->supplies[1].supply, jdi_bool(jdi_regulator_enabled(&jdi->supplies[1])));
+}
+
+static void jdi_dump_gpios(struct jdi_panel *jdi, const char *where)
+{
+	jdi_trace(jdi, where, "gpios: enable=%d reset=%d dcdc_en=%d",
+		jdi_gpio_state(jdi->enable_gpio),
+		jdi_gpio_state(jdi->reset_gpio),
+		jdi_gpio_state(jdi->dcdc_en_gpio));
+}
+
+static void jdi_dump_core_state(struct jdi_panel *jdi, const char *where)
+{
+	char flags[128];
+
+	jdi_format_mode_flags(jdi->dsi->mode_flags, flags, sizeof(flags));
+	jdi_trace(jdi, where,
+		  "state: prepared=%s enabled=%s panel_version=%d v1_init_count=%d v2_init_count=%d lanes=%u format=%u mode_flags=%s",
+		  jdi_bool(jdi->prepared), jdi_bool(jdi->enabled), jdi->panel_version,
+		  jdi->display_v1_init_count, jdi->display_v2_init_count,
+		  jdi->dsi->lanes, jdi->dsi->format, flags);
+	jdi_dump_supplies(jdi, where);
+	jdi_dump_gpios(jdi, where);
+}
+
+static void jdi_dump_runtime_regs(struct jdi_panel *jdi, const char *where)
+{
+	u8 val;
+
+	jdi_trace(jdi, where, "probing panel runtime status registers");
+	if (!jdi_dcs_read_u8(jdi, MIPI_DCS_GET_POWER_MODE, &val))
+		jdi_trace(jdi, where, "GET_POWER_MODE => 0x%02x", val);
+	if (!jdi_dcs_read_u8(jdi, MIPI_DCS_GET_PIXEL_FORMAT, &val))
+		jdi_trace(jdi, where, "GET_PIXEL_FORMAT => 0x%02x", val);
+	if (!jdi_dcs_read_u8(jdi, MIPI_DCS_GET_DISPLAY_MODE, &val))
+		jdi_trace(jdi, where, "GET_DISPLAY_MODE => 0x%02x", val);
+	if (!jdi_dcs_read_u8(jdi, MIPI_DCS_GET_SIGNAL_MODE, &val))
+		jdi_trace(jdi, where, "GET_SIGNAL_MODE => 0x%02x", val);
+	if (!jdi_dcs_read_u8(jdi, MIPI_DCS_GET_DIAGNOSTIC_RESULT, &val))
+		jdi_trace(jdi, where, "GET_DIAGNOSTIC_RESULT => 0x%02x", val);
+}
