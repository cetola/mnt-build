From ccb14ab7029d8bcdc4a300650912a96818b0212c Mon Sep 17 00:00:00 2001
From: Stephano Cetola <stephano@cetola.net>
Date: Sun, 5 Jul 2026 19:51:30 -0700
Subject: [PATCH] drm-dw-mipi-dsi2-enable-LPDT-cmd-during-video-mode

---
 drivers/gpu/drm/bridge/synopsys/dw-mipi-dsi2.c  | 3 +++
 drivers/gpu/drm/panel/panel-mnt-pocket-reform.c | 7 +++++++
 2 files changed, 10 insertions(+)

diff --git a/drivers/gpu/drm/bridge/synopsys/dw-mipi-dsi2.c b/drivers/gpu/drm/bridge/synopsys/dw-mipi-dsi2.c
index a4bfd3ad166d..175b8a6b631a 100644
--- a/drivers/gpu/drm/bridge/synopsys/dw-mipi-dsi2.c
+++ b/drivers/gpu/drm/bridge/synopsys/dw-mipi-dsi2.c
@@ -255,6 +255,9 @@ static void dw_mipi_dsi2_set_vid_mode(struct dw_mipi_dsi2 *dsi2)
 	else
 		val |= VID_MODE_TYPE_NON_BURST_SYNC_EVENTS;
 
+	if (dsi2->mode_flags & MIPI_DSI_MODE_LPM)
+		val |= LPDT_DISPLAY_CMD_EN;
+
 	regmap_write(dsi2->regmap, DSI2_DSI_VID_TX_CFG, val);
 
 	regmap_write(dsi2->regmap, DSI2_MODE_CTRL, VIDEO_MODE);
diff --git a/drivers/gpu/drm/panel/panel-mnt-pocket-reform.c b/drivers/gpu/drm/panel/panel-mnt-pocket-reform.c
index 83783c8a7093..45e1d84ae5e2 100644
--- a/drivers/gpu/drm/panel/panel-mnt-pocket-reform.c
+++ b/drivers/gpu/drm/panel/panel-mnt-pocket-reform.c
@@ -1144,6 +1144,13 @@ static int pocket_display_v2_init(struct jdi_panel *jdi)
 	jdi->display_v2_init_count++;
 	jdi_trace(jdi, __func__, "display_v2_init_count incremented to %d", jdi->display_v2_init_count);
 
+	ret = mipi_dsi_dcs_set_column_address(dsi, 0, 1199);
+	if (ret < 0)
+		dev_warn(dev, "[display v2] set_column_address failed: %d\n", ret);
+	ret = mipi_dsi_dcs_set_page_address(dsi, 0, 1919);
+	if (ret < 0)
+		dev_warn(dev, "[display v2] set_page_address failed: %d\n", ret);
+
 	ret = jdi_dcs_exit_sleep_mode(jdi);
 	if (ret < 0)
 		return ret;
-- 
2.55.0

