 #include <linux/module.h>
 #include <linux/of.h>
 #include <linux/regulator/consumer.h>
@@ -76,6 +77,10 @@ struct jdi_panel {
 	int display_v1_init_count;
 	int display_v2_init_count;
 	u32 trace_seq;
+
+	/* per-command timing for vendor table debug (non-zero while active) */
+	ktime_t v2_table_start;
+	int v2_cmd_idx;
 };
 
 static void jdi_trace(struct jdi_panel *jdi, const char *func, const char *fmt, ...)
@@ -307,6 +312,15 @@ static int dsi_write_raw(struct jdi_panel *jdi, const void *data, size_t len,
 		  min_t(size_t, len, 8), bytes[0] ? bytes : "<empty>", msg.flags);
 
 	ret = dsi->host->ops->transfer(dsi->host, &msg);
+
+	if (jdi->v2_table_start) {
+		int idx = jdi->v2_cmd_idx++;
+		s64 dt = ktime_ms_delta(ktime_get(), jdi->v2_table_start);
+
+		dev_err(dev, "[v2-cmd-%03d] tag=%s dt=%lldms ret=%zd\n",
+			idx, tag ? tag : "?", dt, ret);
+	}
+
 	if (ret < 0) {
 		dev_err(dev,
 			"[display raw] %s failed: ret=%zd len=%zu cmd=0x%02x bytes=%s\n",
@@ -443,10 +457,20 @@ static int pocket_display_v2_init(struct jdi_panel *jdi)
 	jdi_trace(jdi, __func__, "post-soft-reset delay complete");
 	jdi_dump_runtime_regs(jdi, __func__);
 
-	// for unknown reasons, if we send all the data tables
-	// on the first init, it takes very long (~14 seconds),
-	// but it's quick the second time around.
-	if (force_v2_tables_first_init || jdi->display_v2_init_count > 0) {
+	/*
+	 * For init-in-enable (VIDEO_MODE): skip tables on first DRM cycle to
+	 * avoid 14s boot (20ms CRI timeout x ~230 commands).  Send on second
+	 * cycle when VIDEO_MODE is already stable.
+	 * For all other paths (COMMAND_MODE): always send tables — no timeouts.
+	 */
+	{
+	bool init_in_enable = of_property_present(jdi->dsi->dev.of_node, "init-in-enable");
+
+	if (force_v2_tables_first_init || !init_in_enable || jdi->display_v2_init_count > 0) {
+		dev_err(dev, "[v2-init] sending vendor tables (count=%d init_in_enable=%d)\n",
+			jdi->display_v2_init_count, init_in_enable);
+		jdi->v2_table_start = ktime_get();
+		jdi->v2_cmd_idx = 0;
 		ret = dsi_write_raw(jdi, (u8[]) {0xE0,0xAB,0xBA}, 3, "v2-0xE0");
 		if (ret < 0)
 			return ret;
@@ -1137,10 +1161,13 @@ static int pocket_display_v2_init(struct jdi_panel *jdi)
 
 		ret = dsi_write_raw(jdi, (u8[]) {0xFF,0x00}, 2, "v2-0xFF");
 		if (ret < 0)
-			return ret;		dev_info(dev, "[display v2] sent tables OK\n");
+			return ret;
+		jdi->v2_table_start = 0; /* stop per-command timing */
+		dev_info(dev, "[display v2] sent tables OK\n");
 	} else {
 		dev_info(dev, "[display v2] not sending tables this time\n");
 	}
+	} /* end init_in_enable block */
 
 	jdi->display_v2_init_count++;
 	jdi_trace(jdi, __func__, "display_v2_init_count incremented to %d", jdi->display_v2_init_count);
@@ -1670,9 +1697,10 @@ static int jdi_panel_probe(struct mipi_dsi_device *dsi)
 	mipi_dsi_set_drvdata(dsi, jdi);
 
 	jdi->dsi = dsi;
-	jdi_trace(jdi, __func__, "probe start compatible=%pOF init-in-enable=%d probe-mode-lpm=%d burst-mode=%d no-eot-hfp-hbp-hsa=%d vsync-shift=%d",
+	jdi_trace(jdi, __func__, "probe start compatible=%pOF init-in-enable=%d display-on-in-enable=%d probe-mode-lpm=%d burst-mode=%d no-eot-hfp-hbp-hsa=%d vsync-shift=%d",
 		dsi->dev.of_node,
 		of_property_present(dsi->dev.of_node, "init-in-enable"),
+		of_property_present(dsi->dev.of_node, "display-on-in-enable"),
 		of_property_present(dsi->dev.of_node, "probe-mode-lpm"),
 		of_property_present(dsi->dev.of_node, "burst-mode"),
 		of_property_present(dsi->dev.of_node, "no-eot-hfp-hbp-hsa"),
