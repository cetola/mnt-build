diff --git a/drivers/gpu/drm/bridge/synopsys/dw-mipi-dsi2.c b/drivers/gpu/drm/bridge/synopsys/dw-mipi-dsi2.c
index 157080a3a354..1d88da298e6d 100644
--- a/drivers/gpu/drm/bridge/synopsys/dw-mipi-dsi2.c
+++ b/drivers/gpu/drm/bridge/synopsys/dw-mipi-dsi2.c
@@ -15,6 +15,7 @@
 #include <linux/module.h>
 #include <linux/platform_device.h>
 #include <linux/pm_runtime.h>
+#include <linux/ktime.h>
 #include <linux/reset.h>
 
 #include <video/mipi_display.h>
@@ -206,6 +207,8 @@ struct dw_mipi_dsi2 {
 
 	struct drm_display_mode mode;
 	const struct dw_mipi_dsi2_plat_data *plat_data;
+
+	ktime_t vid_mode_start; /* set when VIDEO_MODE becomes active */
 };
 
 static inline struct dw_mipi_dsi2 *host_to_dsi2(struct mipi_dsi_host *host)
@@ -218,24 +221,53 @@ static inline struct dw_mipi_dsi2 *bridge_to_dsi2(struct drm_bridge *bridge)
 	return container_of(bridge, struct dw_mipi_dsi2, bridge);
 }
 
+/*
+ * Drain the CRI RX FIFO by reading header+payload until CRI_RD_DATA_AVAIL
+ * clears.  The DSI2 IP accumulates ACK packets (from BTA-enabled writes) and
+ * calibration-sequence responses in this FIFO.  While data sits unread the
+ * hardware keeps CRI_BUSY asserted, blocking any new LP command from being
+ * sent.  Returns the number of entries drained.
+ */
+static int dw_mipi_dsi2_drain_cri_rx(struct dw_mipi_dsi2 *dsi2)
+{
+	u32 cs, hdr, pld;
+	int count = 0;
+
+	regmap_read(dsi2->regmap, DSI2_CORE_STATUS, &cs);
+	while ((cs & CRI_RD_DATA_AVAIL) && count < 64) {
+		regmap_read(dsi2->regmap, DSI2_CRI_RX_HDR, &hdr);
+		regmap_read(dsi2->regmap, DSI2_CRI_RX_PLD, &pld);
+		count++;
+		regmap_read(dsi2->regmap, DSI2_CORE_STATUS, &cs);
+	}
+	if (count)
+		dev_err(dsi2->dev, "[cri-drain] drained %d entries, CORE_STATUS=0x%08x\n",
+			count, cs);
+	return count;
+}
+
 static int cri_fifos_wait_avail(struct dw_mipi_dsi2 *dsi2)
 {
-	u32 sts, mask;
+	u32 sts, intst;
 	int ret;
 
-	mask = CRI_BUSY | CRT_FIFOS_NOT_EMPTY;
+	/* Drain any pending CRI RX responses to prevent CRI_BUSY from being
+	 * held by unread ACKs (from BTA on write commands) or by calibration
+	 * response packets that the IP queues automatically in VIDEO_MODE. */
+	dw_mipi_dsi2_drain_cri_rx(dsi2);
+
 	ret = regmap_read_poll_timeout(dsi2->regmap, DSI2_CORE_STATUS, sts,
-				       !(sts & mask), 0, CMD_PKT_STATUS_TIMEOUT_US);
+				       !(sts & (CRI_BUSY | CRT_FIFOS_NOT_EMPTY)),
+				       0, CMD_PKT_STATUS_TIMEOUT_US);
 	if (ret < 0) {
-		u32 mode_sts;
-
-		regmap_read(dsi2->regmap, DSI2_MODE_STATUS, &mode_sts);
-		dev_err(dsi2->dev, "command interface is busy: CORE_STATUS=0x%08x MODE_STATUS=0x%08x\n",
-			sts, mode_sts);
-		return ret;
+		regmap_read(dsi2->regmap, DSI2_INT_ST_CRI, &intst);
+		dev_err(dsi2->dev,
+			"[cri-wait] timeout: CORE_STATUS=0x%08x INT_ST_CRI=0x%08x vid_ms=%lld\n",
+			sts, intst,
+			dsi2->vid_mode_start ?
+				ktime_ms_delta(ktime_get(), dsi2->vid_mode_start) : -1LL);
 	}
-
-	return 0;
+	return ret;
 }
 
 static void dw_mipi_dsi2_set_vid_mode(struct dw_mipi_dsi2 *dsi2)
@@ -264,6 +296,10 @@ static void dw_mipi_dsi2_set_vid_mode(struct dw_mipi_dsi2 *dsi2)
 
 	regmap_write(dsi2->regmap, DSI2_DSI_VID_TX_CFG, val);
 
+	/* Drain CRI RX FIFO before entering VIDEO_MODE to prevent accumulated
+	 * COMMAND_MODE ACKs from causing immediate CRI_BUSY after the switch. */
+	dw_mipi_dsi2_drain_cri_rx(dsi2);
+
 	{
 		u32 cs;
 
@@ -279,13 +315,15 @@ static void dw_mipi_dsi2_set_vid_mode(struct dw_mipi_dsi2 *dsi2)
 	if (ret < 0)
 		dev_err(dsi2->dev, "failed to enter video mode\n");
 
+	dsi2->vid_mode_start = ktime_get();
+
 	{
 		u32 cs, ms, vtcfg;
 
 		regmap_read(dsi2->regmap, DSI2_CORE_STATUS, &cs);
 		regmap_read(dsi2->regmap, DSI2_MODE_STATUS, &ms);
 		regmap_read(dsi2->regmap, DSI2_DSI_VID_TX_CFG, &vtcfg);
-		dev_err(dsi2->dev, "[dbg] set_vid_mode: post-switch CORE_STATUS=0x%08x MODE_STATUS=0x%08x VID_TX_CFG=0x%08x\n",
+		dev_err(dsi2->dev, "[dbg] set_vid_mode: post-switch CORE_STATUS=0x%08x MODE_STATUS=0x%08x VID_TX_CFG=0x%08x vid_mode_start_set\n",
 			cs, ms, vtcfg);
 	}
 }
