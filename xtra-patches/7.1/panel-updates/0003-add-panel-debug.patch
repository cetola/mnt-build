-static ssize_t dsi_write_raw(struct mipi_dsi_device *dsi,
-                             const void *data, size_t len)
+static int dsi_write_raw(struct jdi_panel *jdi, const void *data, size_t len,
+			 const char *tag)
 {
+	struct mipi_dsi_device *dsi = jdi->dsi;
+	struct device *dev = &dsi->dev;
+	const u8 *buf = data;
 	const struct mipi_dsi_msg msg = {
 		.channel = dsi->channel,
 		.tx_buf = data,
 		.tx_len = len,
 		.type = MIPI_DSI_DCS_LONG_WRITE,
-		.flags = MIPI_DSI_MSG_USE_LPM
+		.flags = MIPI_DSI_MSG_USE_LPM,
 	};
+	ssize_t ret;
+
+	ret = dsi->host->ops->transfer(dsi->host, &msg);
+	if (ret < 0) {
+		dev_err(dev,
+			"[display raw] %s failed: ret=%zd len=%zu cmd=0x%02x\n",
+			tag ? tag : "write", ret, len, len ? buf[0] : 0xff);
+		return ret;
+	}
+
+	dev_dbg(dev,
+		"[display raw] %s ok: ret=%zd len=%zu cmd=0x%02x\n",
+		tag ? tag : "write", ret, len, len ? buf[0] : 0xff);
+
+	return 0;
+}
+
+static int jdi_dcs_soft_reset(struct jdi_panel *jdi)
+{
+	int ret = mipi_dsi_dcs_soft_reset(jdi->dsi);
+	if (ret < 0)
+		dev_err(&jdi->dsi->dev,
+			"[display dcs] soft_reset failed: %d\n", ret);
+	return ret;
+}
+
+static int jdi_dcs_exit_sleep_mode(struct jdi_panel *jdi)
+{
+	int ret = mipi_dsi_dcs_exit_sleep_mode(jdi->dsi);
+	if (ret < 0)
+		dev_err(&jdi->dsi->dev,
+			"[display dcs] exit_sleep_mode failed: %d\n", ret);
+	return ret;
+}
+
+static int jdi_dcs_set_display_on(struct jdi_panel *jdi)
+{
+	int ret = mipi_dsi_dcs_set_display_on(jdi->dsi);
+	if (ret < 0)
+		dev_err(&jdi->dsi->dev,
+			"[display dcs] set_display_on failed: %d\n", ret);
+	return ret;
+}
 
-	return dsi->host->ops->transfer(dsi->host, &msg);
+static int jdi_dcs_set_display_off(struct jdi_panel *jdi)
